---
const defaultQuestions = [
  "Where should I start with Go?",
  "Explain Kotlin backend setup",
  "How do I use mise for dev tools?",
  "What does the ERPNext guide cover?",
  "Summarize multi-tenant Cloudflare architecture",
  "How should I practice Vim motions?",
];
---

<div data-sn-ai>
  <button
    class="fixed right-4 bottom-4 z-30 inline-grid place-items-center w-12 h-12 rounded-full border border-[color-mix(in_srgb,var(--sl-color-white)_15%,transparent)] bg-[var(--sl-color-black)] text-[var(--sl-color-white)] shadow-xl cursor-pointer transition-all duration-300 hover:scale-105 hover:shadow-2xl active:scale-95 group focus-visible:outline-2 focus-visible:outline-[var(--sl-color-accent)] focus-visible:outline-offset-3 [&.is-hidden]:opacity-0 [&.is-hidden]:pointer-events-none [&.is-hidden]:translate-y-2.5 [&.is-hidden]:scale-90"
    type="button"
    data-ai-open
    aria-label="Ask slopnotes AI"
    aria-expanded="false"
  >
    <span
      class="inline-grid place-items-center text-[var(--sl-color-accent)] group-hover:scale-105 transition-transform"
      aria-hidden="true"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
        <path
          d="M12 3l1.85 5.1L19 10l-5.15 1.9L12 17l-1.85-5.1L5 10l5.15-1.9L12 3Z"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linejoin="round"></path>
        <path
          d="M19 15l.75 2.25L22 18l-2.25.75L19 21l-.75-2.25L16 18l2.25-.75L19 15Z"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"></path>
      </svg>
    </span>
    <span class="sr-only">Ask AI</span>
  </button>

  <div
    class="fixed inset-0 z-[140] bg-black/0 backdrop-blur-0 pointer-events-none transition-all duration-400 [&.is-visible]:bg-black/15 [&.is-visible]:dark:bg-black/25 [&.is-visible]:backdrop-blur-[3px] [&.is-visible]:pointer-events-auto"
    data-ai-backdrop
    data-ai-close
    hidden
  >
  </div>

  <aside
    class="fixed z-[150] isolate flex flex-col overflow-hidden transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] opacity-0 pointer-events-none translate-y-6 scale-[0.96] origin-bottom-right w-[calc(100vw-1rem)] h-[calc(100dvh-4rem)] rounded-3xl border border-[color-mix(in_srgb,var(--sl-color-white)_12%,transparent)] bg-[color-mix(in_srgb,var(--sl-color-black)_94%,transparent)] backdrop-blur-lg shadow-2xl bottom-2 right-2 max-w-[26rem] sm:bottom-4 sm:right-4 [&.is-visible]:opacity-100 [&.is-visible]:pointer-events-auto [&.is-visible]:translate-y-0 [&.is-visible]:scale-100 [&.is-expanded]:pointer-events-auto [&.is-expanded]:max-w-3xl [&.is-expanded]:right-1/2 [&.is-expanded]:translate-x-1/2 [&.is-expanded]:origin-bottom-center max-sm:bottom-0 max-sm:right-0 max-sm:w-full max-sm:h-[calc(100dvh-4rem)] max-sm:border-x-0 max-sm:border-b-0 max-sm:rounded-t-3xl max-sm:rounded-b-none max-sm:translate-y-full max-sm:origin-bottom-center max-sm:[&.is-visible]:translate-y-0 max-sm:[&.is-visible]:w-full max-sm:[&.is-visible]:right-0 max-sm:[&.is-expanded]:w-full max-sm:[&.is-expanded]:right-0 max-sm:[&.is-expanded]:translate-x-0"
    data-ai-panel
    hidden
    aria-label="Slopnotes AI assistant"
    aria-live="polite"
  >
    <div
      class="absolute inset-x-0 top-0 z-10 h-16 pointer-events-none bg-gradient-to-b from-[var(--sl-color-black)] to-transparent"
      aria-hidden="true"
    >
    </div>

    <header
      class="relative z-12 flex items-center justify-between gap-3 px-3 py-1.5 border-b border-[color-mix(in_srgb,var(--sl-color-white)_10%,transparent)] bg-[color-mix(in_srgb,var(--sl-color-black)_95%,transparent)]"
    >
      <div class="min-w-0 pt-0.5">
        <h2
          class="m-0 text-[var(--sl-color-white)] font-mono font-semibold tracking-tight leading-none"
          style="font-size: 1rem;"
        >
          slopnotes<sup
            class="inline-block ml-0.5 text-[var(--sl-color-accent)] font-sans font-medium tracking-normal -translate-y-[0.1em]"
            style="font-size: 0.62em;"
            >AI</sup
          >
        </h2>
      </div>
      <div
        class="flex items-center gap-0.5 p-0.5 rounded-full bg-[color-mix(in_srgb,var(--sl-color-white)_5%,transparent)]"
      >
        <button
          type="button"
          class="inline-grid place-items-center size-7 rounded-full border-0 bg-transparent text-[var(--sl-color-gray-3)] cursor-pointer hover:text-[var(--sl-color-white)] hover:bg-[color-mix(in_srgb,var(--sl-color-white)_8%,transparent)] transition-all duration-200 active:scale-90 [&.is-disabled]:w-0 [&.is-disabled]:opacity-0 [&.is-disabled]:pointer-events-none"
          data-ai-new
          title="New chat"
          aria-label="Start a new chat"
          disabled
        >
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none"
            ><path
              d="M4 7h16M10 11v6M14 11v6M6 7l1 14h10l1-14M9 7V4h6v3"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
        </button>
        <button
          type="button"
          class="max-sm:hidden inline-grid place-items-center size-7 rounded-full border-0 bg-transparent text-[var(--sl-color-gray-3)] cursor-pointer hover:text-[var(--sl-color-white)] hover:bg-[color-mix(in_srgb,var(--sl-color-white)_8%,transparent)] transition-all duration-200 active:scale-90"
          data-ai-expand
          title="Expand"
          aria-label="Expand chat window"
        >
          <svg
            data-icon-expand
            class="size-3.5"
            viewBox="0 0 24 24"
            fill="none"
            ><path
              d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
          <svg
            data-icon-collapse
            class="size-3.5"
            viewBox="0 0 24 24"
            fill="none"
            style="display:none"
            ><path
              d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
        </button>
        <button
          type="button"
          class="inline-grid place-items-center size-7 rounded-full border-0 bg-transparent text-[var(--sl-color-gray-3)] cursor-pointer hover:text-[var(--sl-color-white)] hover:bg-[color-mix(in_srgb,var(--sl-color-white)_8%,transparent)] transition-all duration-200 active:scale-90"
          data-ai-close
          title="Close"
          aria-label="Close AI chat"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none"
            ><path
              d="M6 6l12 12M18 6L6 18"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path></svg
          >
        </button>
      </div>
    </header>

    <div
      class="relative z-10 flex-1 min-h-0 overflow-x-hidden overflow-y-auto px-3 py-2.5 scroll-smooth custom-scrollbar text-sm text-[color-mix(in_srgb,var(--sl-color-white)_85%,transparent)]"
      data-ai-messages
    >
      <section
        class="flex flex-col items-center justify-center min-h-full py-6 text-center animate-empty-in"
        data-ai-empty
      >
        <div class="w-full max-w-[20rem]">
          <h4
            class="m-0 mb-1.5 text-[var(--sl-color-gray-3)] font-mono text-[0.55rem] font-semibold tracking-wider uppercase"
          >
            Example Questions
          </h4>
          <div
            class="flex flex-wrap justify-center gap-1"
            aria-label="Example questions"
          >
            {
              defaultQuestions.map((question) => (
                <button
                  class="px-2 py-0.5 rounded-full text-[0.6rem] border border-transparent bg-[color-mix(in_srgb,var(--sl-color-white)_5%,transparent)] text-[var(--sl-color-gray-3)] hover:border-[color-mix(in_srgb,var(--sl-color-accent)_20%,transparent)] hover:bg-[color-mix(in_srgb,var(--sl-color-accent)_8%,transparent)] hover:text-[var(--sl-color-accent)] cursor-pointer transition-all duration-200 active:scale-95"
                  type="button"
                  data-ai-example={question}
                >
                  {question}
                </button>
              ))
            }
          </div>
        </div>
      </section>

      <div
        class="inline-flex items-center gap-1.5 mt-1.25 mb-4 pl-0.5 origin-bottom-left"
        data-ai-typing
        hidden
        aria-hidden="true"
      >
        <img src="/assets/ai.svg" alt="logo" class="size-4" />
        <p class="m-0 text-sm text-[var(--sl-color-gray-3)]" data-ai-typing-label>
          Thinking<span data-ai-typing-dots>.</span>
        </p>
      </div>
    </div>

    <footer class="relative z-20 px-2 pb-2 pt-1 bg-transparent">
      <div
        class="absolute left-2 bottom-[calc(100%+0.25rem)] flex flex-col gap-1 max-w-[calc(100%-1rem)] text-[var(--sl-color-gray-3)] pointer-events-none"
        data-ai-footer-status
      >
        <div
          class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[0.6rem] leading-none opacity-60 pointer-events-auto"
          data-ai-verify-status
          hidden
        >
          <svg class="size-3 flex-none animate-spin" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" opacity="0.25"></circle>
            <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <p class="m-0" data-ai-verify-text>Verifying that you're a human<span data-ai-verify-dots>.</span></p>
        </div>
        <div
          class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[0.6rem] leading-none opacity-60 pointer-events-auto"
          data-ai-verify-slow
          hidden
        >
          <p class="m-0">This seems to be taking longer than usual. You might want to <button class="underline bg-transparent border-0 text-inherit cursor-pointer p-0 text-[0.6rem]" data-ai-reload type="button">Reload the page</button>.</p>
        </div>
        <div
          class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[0.6rem] leading-none text-[color-mix(in_srgb,#ef4444_72%,var(--sl-color-white))] pointer-events-auto"
          data-ai-error-status
          hidden
        >
          <svg class="size-3 flex-none" viewBox="0 0 24 24" fill="none">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0zM12 9v4M12 17h.01" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <p class="m-0" data-ai-error-text></p>
          <button class="underline bg-transparent border-0 text-inherit cursor-pointer p-0 text-[0.6rem]" data-ai-error-retry type="button">Try again</button>
          <span>or</span>
          <button class="underline bg-transparent border-0 text-inherit cursor-pointer p-0 text-[0.6rem]" data-ai-error-reload type="button">Reload the page</button>
        </div>
      </div>
      <form
        data-ai-form
        class="flex flex-col gap-0.5 border border-[color-mix(in_srgb,var(--sl-color-white)_12%,transparent)] rounded-[1.25rem] bg-[color-mix(in_srgb,var(--sl-color-white)_4%,transparent)] backdrop-blur-md shadow-sm transition-all duration-200 focus-within:border-[color-mix(in_srgb,var(--sl-color-accent)_35%,transparent)] focus-within:shadow-[0_0_0_2px_color-mix(in_srgb,var(--sl-color-accent)_10%,transparent)]"
      >
        <textarea
          data-ai-input
          rows="1"
          maxlength="4096"
          placeholder="What's on your mind?"
          aria-label="Ask slopnotes AI"
          data-gramm="false"
          class="w-full max-h-[120px] resize-none border-0 rounded-t-[1.25rem] px-3 pt-2.5 pb-1 bg-transparent text-[var(--sl-color-white)] text-xs outline-none placeholder:text-[var(--sl-color-gray-3)] leading-normal"
        ></textarea>
        <div class="flex items-center gap-1 px-1.5 pb-1.5">
          <button
            type="button"
            class="inline-flex items-center gap-1 h-6 px-2 rounded-full border border-transparent text-[0.65rem] font-medium text-[var(--sl-color-gray-3)] bg-transparent hover:bg-[color-mix(in_srgb,var(--sl-color-white)_8%,transparent)] transition-all duration-200 active:scale-95 cursor-pointer [&.is-active]:border-[color-mix(in_srgb,var(--sl-color-accent)_25%,transparent)] [&.is-active]:bg-[color-mix(in_srgb,var(--sl-color-accent)_12%,transparent)] [&.is-active]:text-[var(--sl-color-accent)]"
            data-ai-reference
            title="Use current page as context"
            aria-label="Include current page"
            aria-pressed="false"
          >
            <svg class="size-3 stroke-1.5" viewBox="0 0 24 24" fill="none"
              ><path
                d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
            <span class="max-sm:hidden">Page</span>
          </button>
          <button
            type="button"
            class="inline-flex items-center gap-1 h-6 px-2 rounded-full border border-transparent text-[0.65rem] font-medium text-[var(--sl-color-gray-3)] bg-transparent hover:bg-[color-mix(in_srgb,var(--sl-color-white)_8%,transparent)] transition-all duration-200 active:scale-95 cursor-pointer [&.is-active]:border-[color-mix(in_srgb,var(--sl-color-accent)_25%,transparent)] [&.is-active]:bg-[color-mix(in_srgb,var(--sl-color-accent)_12%,transparent)] [&.is-active]:text-[var(--sl-color-accent)]"
            data-ai-think
            title="Think harder for better answers"
            aria-label="Think deeper"
            aria-pressed="false"
          >
            <svg class="size-3 stroke-1.5" viewBox="0 0 24 24" fill="none"
              ><path
                d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2Z"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
            <span class="max-sm:hidden">Deep</span>
          </button>
          <button
            class="ml-auto size-7 rounded-full grid place-items-center bg-[color-mix(in_srgb,var(--sl-color-white)_8%,transparent)] text-[var(--sl-color-gray-3)] hover:bg-[color-mix(in_srgb,var(--sl-color-accent)_14%,transparent)] hover:text-[var(--sl-color-accent)] [&.is-streaming]:bg-[color-mix(in_srgb,#ef6b6b_15%,transparent)] [&.is-streaming]:text-[#ef6b6b] transition-all duration-200 active:scale-90 cursor-pointer"
            type="submit"
            data-ai-send
            aria-label="Send message"
            title="Send message"
          >
            <svg
              data-ai-send-icon
              class="size-3.5"
              viewBox="0 0 24 24"
              fill="none"
              ><path
                d="M5 12h13M13 6l6 6-6 6"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
            <svg
              data-ai-stop-icon
              class="size-3.5"
              viewBox="0 0 24 24"
              fill="none"
              style="display: none;"
              ><rect
                x="7"
                y="7"
                width="10"
                height="10"
                rx="1"
                stroke="currentColor"
                stroke-width="1.9"></rect></svg
            >
          </button>
        </div>
      </form>
      <p
        class="max-sm:hidden text-center text-[0.55rem] text-[var(--sl-color-gray-3)] opacity-60 mt-1.5"
      >
        <kbd
          class="px-1 py-0.5 rounded border border-[color-mix(in_srgb,var(--sl-color-white)_8%,transparent)] bg-[color-mix(in_srgb,var(--sl-color-white)_3%,transparent)] text-[var(--sl-color-gray-3)] font-mono text-[0.5rem]"
          >Enter</kbd
        > send · <kbd
          class="px-1 py-0.5 rounded border border-[color-mix(in_srgb,var(--sl-color-white)_8%,transparent)] bg-[color-mix(in_srgb,var(--sl-color-white)_3%,transparent)] text-[var(--sl-color-gray-3)] font-mono text-[0.5rem]"
          >Shift+Enter</kbd
        > newline · <kbd
          class="px-1 py-0.5 rounded border border-[color-mix(in_srgb,var(--sl-color-white)_8%,transparent)] bg-[color-mix(in_srgb,var(--sl-color-white)_3%,transparent)] text-[var(--sl-color-gray-3)] font-mono text-[0.5rem]"
          >Ctrl</kbd
        >/<kbd
          class="px-1 py-0.5 rounded border border-[color-mix(in_srgb,var(--sl-color-white)_8%,transparent)] bg-[color-mix(in_srgb,var(--sl-color-white)_3%,transparent)] text-[var(--sl-color-gray-3)] font-mono text-[0.5rem]"
          >⌘</kbd
        >+<kbd
          class="px-1 py-0.5 rounded border border-[color-mix(in_srgb,var(--sl-color-white)_8%,transparent)] bg-[color-mix(in_srgb,var(--sl-color-white)_3%,transparent)] text-[var(--sl-color-gray-3)] font-mono text-[0.5rem]"
          >I</kbd
        > toggle
      </p>
    </footer>

    <div
      class="absolute w-px h-px overflow-hidden opacity-[0.01] pointer-events-none"
      data-ai-turnstile
    >
    </div>
  </aside>
</div>
<script>
  // ── Global typed window cast ──
  interface SlopnotesAIOptions {
    includeCurrentPage?: boolean;
    value?: string;
    submit?: boolean;
  }

  type HistoryItem = {
    role: "user" | "assistant";
    content: string;
    checksum?: string;
  };

  const globalWindow = window as typeof window & {
    __slopnotesAIFabListener?: boolean;
    __slopnotesAIKeyListener?: boolean;
    __slopnotesAIThemeObserver?: boolean;
    slopnotesAI?: {
      toggle: (opts?: SlopnotesAIOptions) => void;
      open: () => void;
      close: () => void;
      expand: () => void;
      minimize: () => void;
      rehighlight?: () => void;
    };
    slopnotesTurnstileCallback?: (token: string) => void;
    turnstile?: {
      reset: () => void;
      render: (element: HTMLElement, options: any) => string;
    };
  };

  // ── Persistent state across view transitions (module scope) ──
  let history: HistoryItem[] = [];
  let powToken: string | undefined | null;
  let turnstileToken: string | undefined | null;
  let authStarted = false;
  let streaming = false;
  let isOpen = false;
  let isExpanded = true;
  let includeCurrentPage = false;
  let thinkHarder = false;
  let lastError: string | undefined;
  let lastFailedMessage: string | undefined;

  let controller: AbortController | undefined;
  let powWorker: Worker | null = null;

  // UX / submission synchronization state matching reference
  let requestSubmit = false;
  let pendingMessage: string | undefined;
  let pendingUserBubble: HTMLElement | undefined;
  let authStartTime = 0;

  // Timers
  let typingDotTimer: number | undefined;
  let typingDelayTimer: number | undefined;
  let verifyDotTimer: number | undefined;
  let typingAnimationTimer: number | undefined;
  let verifyStatusTimer: number | undefined;
  let verifySlowTimer: number | undefined;
  let errorStatusTimer: number | undefined;

  // Constants
  const metadataSeparator = "\n---Metadata---";
  const VERIFY_SHOW_DELAY_MS = 6000;
  const VERIFY_SLOW_DELAY_MS = 13000;
  const typingPhrases = [
    "Cooking",
    "Thinking",
    "Analyzing",
    "Typing",
    "Looking for your answer",
    "Preparing your waifu's cosplay",
    "Finding the meaning of life",
    "Summoning eldritch horrors",
    "Looking through the library",
    "Calculating infinity",
    "Brewing potions",
    "Exploring the multiverse",
    "Decoding ancient scripts",
    "Aligning the stars",
    "Charging magical energies",
    "Consulting the oracle",
    "Traversing time streams",
    "Communing with nature",
    "Unlocking hidden knowledge",
  ];

  // ── Lazy-loaded Markdown and Shiki instances ──
  let markdownInstance: any = null;
  let markdownPromise: Promise<any> | null = null;
  let highlighterPromise:
    | Promise<{ highlighter: any; addCopyButton: any }>
    | undefined;

  async function getMarkdown() {
    if (markdownInstance) return markdownInstance;
    if (markdownPromise) return markdownPromise;

    markdownPromise = import("markdown-it").then(({ default: MarkdownIt }) => {
      const md = new MarkdownIt({
        html: false,
        linkify: true,
        breaks: true,
        typographer: true,
      });

      md.validateLink = (url: string) => {
        try {
          const parsed = new URL(url, window.location.origin);
          return ["http:", "https:", "mailto:"].includes(parsed.protocol);
        } catch {
          return false;
        }
      };

      md.renderer.rules.link_open = (
        tokens: any[],
        idx: number,
        options: any,
        _env: any,
        self: any,
      ) => {
        const token = tokens[idx];
        const hrefIndex = token.attrIndex("href");
        if (hrefIndex >= 0)
          token.attrs[hrefIndex][1] = sanitizeHref(
            token.attrs[hrefIndex][1] || "#",
          );
        token.attrSet("target", "_blank");
        token.attrSet("rel", "noreferrer");
        return self.renderToken(tokens, idx, options);
      };
      md.renderer.rules.fence = (tokens: any[], idx: number) => {
        const token = tokens[idx];
        const info = String(token.info || "").trim();
        const lang = normalizeLanguage(info.split(/\s+/)[0] || "text");
        const displayLang = lang === "text" ? "txt" : lang;
        return `<div class="relative my-3 -mx-3 border-y border-[var(--sn-ai-code-border)] bg-[var(--sn-ai-code-bg)] sm:mx-0 sm:rounded-xl sm:border overflow-hidden" data-sn-code-block data-lang="${escapeHtml(lang)}"><div class="flex items-center justify-end min-h-8 px-4 border-b border-[var(--sn-ai-code-border)]/50 text-[var(--sn-ai-code-header-text)] font-mono text-[0.66rem] tracking-wider uppercase"><span>${escapeHtml(displayLang)}</span></div><pre class="relative overflow-x-auto m-0 p-3 bg-transparent!"><code class="block min-w-max border-0 rounded-none p-0 bg-transparent text-[var(--sn-ai-code-text)] text-xs leading-relaxed language-${escapeHtml(lang)}">${escapeHtml(token.content)}</code></pre></div>`;
      };

      markdownInstance = md;
      return md;
    });

    return markdownPromise;
  }

  const shikiLanguages = [
    "text",
    "markdown",
    "html",
    "css",
    "scss",
    "json",
    "yaml",
    "toml",
    "bash",
    "shell",
    "dockerfile",
    "javascript",
    "typescript",
    "jsx",
    "tsx",
    "go",
    "python",
    "kotlin",
    "java",
    "rust",
    "sql",
    "vue",
  ];

  const powWorkerCode = `
    self.onmessage = async function(e) {
      const { apiBase } = e.data;
      try {
        const res = await fetch(apiBase + "/pow/request", { credentials: "include" });
        if (!res.ok) { self.postMessage({ error: "PoW request failed" }); return; }
        const challenge = await res.json();
        const target = "0".repeat(Math.floor(Number(challenge.bits || 0) / 4));
        let suffix = 0;
        while (true) {
          const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(challenge.nonce + ":" + suffix));
          const hash = Array.from(new Uint8Array(digest)).map(b => b.toString(16).padStart(2, "0")).join("");
          if (hash.startsWith(target)) { self.postMessage({ suffix: String(suffix) }); return; }
          suffix++;
          if (suffix % 2000 === 0) await new Promise(r => setTimeout(r, 0));
        }
      } catch (err) { self.postMessage({ error: String(err) }); }
    };
  `;

  function createPowWorker() {
    try {
      const blob = new Blob([powWorkerCode], { type: "application/javascript" });
      return new Worker(URL.createObjectURL(blob));
    } catch {
      return null;
    }
  }

  // ── Active DOM elements and state for the CURRENT page load ──
  let root: HTMLElement | null = null;
  let apiBase = "";
  let turnstileSiteKey = "";

  // Elements
  let fab: HTMLElement | null = null;
  let backdrop: HTMLElement | null = null;
  let panel: HTMLElement | null = null;
  let newButton: HTMLElement | null = null;
  let expandButton: HTMLButtonElement | null = null;
  let iconExpand: SVGElement | null = null;
  let iconCollapse: SVGElement | null = null;
  let form: HTMLElement | null = null;
  let input: HTMLTextAreaElement | null = null;
  let sendButton: HTMLButtonElement | null = null;
  let sendIcon: SVGElement | null = null;
  let stopIcon: SVGElement | null = null;
  let messages: HTMLElement | null = null;
  let empty: HTMLElement | null = null;
  let typingIndicator: HTMLElement | null = null;
  let referenceButton: HTMLButtonElement | null = null;
  let thinkButton: HTMLButtonElement | null = null;
  let turnstileHost: HTMLElement | null = null;
  let verifyStatus: HTMLElement | null = null;
  let verifyDots: HTMLElement | null = null;
  let verifySlow: HTMLElement | null = null;
  let errorStatus: HTMLElement | null = null;
  let errorText: HTMLElement | null = null;
  let errorRetry: HTMLElement | null = null;
  let errorReload: HTMLElement | null = null;
  let reloadBtn: HTMLElement | null = null;
  let typingLabel: HTMLElement | null = null;
  let typingDots: HTMLElement | null = null;

  // ── Setup & teardown functions ──
  function setupPage() {
    root = document.querySelector("[data-sn-ai]");
    if (!(root instanceof HTMLElement)) return;

    apiBase = (
      import.meta.env.PUBLIC_SLOPNOTES_RAG_URL ||
      (import.meta.env.DEV
        ? "http://localhost:8787"
        : "https://slopnote-rag.kuldeep.tech")
    ).replace(/\/$/, "");
    turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
    if (!turnstileSiteKey) {
      turnstileToken = "dev-bypass";
    }

    fab = root.querySelector("[data-ai-open]");
    backdrop = root.querySelector("[data-ai-backdrop]");
    panel = root.querySelector("[data-ai-panel]");
    newButton = root.querySelector("[data-ai-new]");
    expandButton = root.querySelector("[data-ai-expand]");
    iconExpand = root.querySelector("[data-icon-expand]");
    iconCollapse = root.querySelector("[data-icon-collapse]");
    form = root.querySelector("[data-ai-form]");
    input = root.querySelector("[data-ai-input]");
    sendButton = root.querySelector("[data-ai-send]");
    sendIcon = root.querySelector("[data-ai-send-icon]");
    stopIcon = root.querySelector("[data-ai-stop-icon]");
    messages = root.querySelector("[data-ai-messages]");
    empty = root.querySelector("[data-ai-empty]");
    typingIndicator = root.querySelector("[data-ai-typing]");
    referenceButton = root.querySelector("[data-ai-reference]");
    thinkButton = root.querySelector("[data-ai-think]");
    turnstileHost = root.querySelector("[data-ai-turnstile]");
    verifyStatus = root.querySelector("[data-ai-verify-status]");
    verifyDots = root.querySelector("[data-ai-verify-dots]");
    verifySlow = root.querySelector("[data-ai-verify-slow]");
    errorStatus = root.querySelector("[data-ai-error-status]");
    errorText = root.querySelector("[data-ai-error-text]");
    errorRetry = root.querySelector("[data-ai-error-retry]");
    errorReload = root.querySelector("[data-ai-error-reload]");
    reloadBtn = root.querySelector("[data-ai-reload]");
    typingLabel = root.querySelector("[data-ai-typing-label]");
    typingDots = root.querySelector("[data-ai-typing-dots]");

    // Error / reload button listeners
    reloadBtn?.addEventListener("click", () => window.location.reload());
    errorReload?.addEventListener("click", () => window.location.reload());
    errorRetry?.addEventListener("click", () => {
      if (streaming || !lastFailedMessage || !input) return;
      hideFooterError();
      input.value = lastFailedMessage;
      autoSize(input);
      void ask();
    });

    // Example questions click listeners
    root.querySelectorAll("[data-ai-example]").forEach((button) => {
      button.addEventListener("click", () => {
        if (input && button instanceof HTMLElement) {
          input.value = button.dataset.aiExample || "";
          autoSize(input);
          void ask();
        }
      });
    });

    // Close buttons click listeners
    root.querySelectorAll("[data-ai-close]").forEach((button) => {
      button.addEventListener("click", () => setOpen(false));
    });

    newButton?.addEventListener("click", startNewChat);
    expandButton?.addEventListener("click", () => setExpanded(!isExpanded));

    referenceButton?.addEventListener("click", () => {
      includeCurrentPage = !includeCurrentPage;
      referenceButton?.classList.toggle("is-active", includeCurrentPage);
      referenceButton?.setAttribute("aria-pressed", String(includeCurrentPage));
    });

    thinkButton?.addEventListener("click", () => {
      thinkHarder = !thinkHarder;
      thinkButton?.classList.toggle("is-active", thinkHarder);
      thinkButton?.setAttribute("aria-pressed", String(thinkHarder));
    });

    if (input) {
      input.addEventListener("input", () => autoSize(input!));
      input.addEventListener("keydown", (event) => {
        if (event.key === "Enter" && !event.shiftKey) {
          event.preventDefault();
          void ask();
        }
      });
    }

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (streaming) cancelRequest();
      else void ask();
    });

    // Sync button / controls status with active state
    referenceButton?.classList.toggle("is-active", includeCurrentPage);
    referenceButton?.setAttribute("aria-pressed", String(includeCurrentPage));
    thinkButton?.classList.toggle("is-active", thinkHarder);
    thinkButton?.setAttribute("aria-pressed", String(thinkHarder));
    setExpanded(isExpanded);
    updateSendButton();

    // ── Expose global API ──
    globalWindow.slopnotesAI = {
      toggle: (opts?: SlopnotesAIOptions) => {
        if (opts) {
          setOpen(true);
        } else {
          setOpen(!isOpen);
        }
        if (opts?.includeCurrentPage !== undefined) {
          includeCurrentPage = opts.includeCurrentPage;
          referenceButton?.classList.toggle("is-active", includeCurrentPage);
          referenceButton?.setAttribute(
            "aria-pressed",
            String(includeCurrentPage),
          );
        }
        if (opts?.value && input) {
          input.value = opts.value;
          autoSize(input);
        }
        if (opts?.submit) void ask();
      },
      open: () => setOpen(true),
      close: () => setOpen(false),
      expand: () => setExpanded(true),
      minimize: () => setExpanded(false),
      rehighlight: () => {
        if (messages) highlightCodeBlocks(messages);
      },
    };

    // If chat is currently open, show it instantly without animation lag
    if (isOpen) {
      fab?.classList.add("is-hidden");
      panel?.removeAttribute("hidden");
      backdrop?.removeAttribute("hidden");
      panel?.classList.add("is-visible");
      backdrop?.classList.add("is-visible");
      panel?.classList.toggle("is-expanded", isExpanded);
      document.documentElement.classList.add("sn-ai-open");

      // If we are currently verifying/authed, make sure Turnstile / PoW are set
      if (authStarted) {
        loadTurnstile();
      }
    } else {
      fab?.classList.remove("is-hidden");
      panel?.classList.remove("is-visible");
      backdrop?.classList.remove("is-visible");
      panel?.setAttribute("hidden", "");
      backdrop?.setAttribute("hidden", "");
      document.documentElement.classList.remove("sn-ai-open");
    }

    // Re-render chat history in the new DOM container
    restoreChatHistory();
  }

  function teardownPage() {
    // Clear page-specific timers to avoid running them against destroyed DOM
    window.clearTimeout(typingDelayTimer);
    window.clearInterval(typingDotTimer);
    window.clearInterval(verifyDotTimer);
    typingDelayTimer = undefined;
    typingDotTimer = undefined;
    verifyDotTimer = undefined;

    // Abort active query on transition
    if (streaming) {
      cancelRequest();
    }
  }

  // Restores DOM message elements from history array
  async function restoreChatHistory() {
    if (!messages) return;
    messages
      .querySelectorAll("article")
      .forEach((node) => node.remove());

    if (history.length > 0) {
      empty?.setAttribute("hidden", "");
      for (const item of history) {
        await appendMessage(item.role, item.content);
      }
      // Show disclaimer + actions only on last assistant message
      attachLastAssistantMeta();
      // Trigger code highlight on restored items
      await highlightCodeBlocks(messages);
    } else {
      empty?.removeAttribute("hidden");
    }
  }

  // Show disclaimer + action buttons only on the last assistant message,
  // and only when not streaming and no error — matching reference behavior.
  function attachLastAssistantMeta() {
    if (!messages) return;
    // Remove any existing disclaimers/action bars
    messages.querySelectorAll(".sn-ai-disclaimer, .sn-ai-actions").forEach(el => el.remove());

    if (streaming || lastError) return;

    // Find the last assistant article
    const articles = messages.querySelectorAll("article");
    let lastAssistant: HTMLElement | null = null;
    for (let i = articles.length - 1; i >= 0; i--) {
      const art = articles[i];
      if (art instanceof HTMLElement && art.classList.contains("sn-role-assistant")) {
        lastAssistant = art;
        break;
      }
    }
    if (!lastAssistant) return;

    const lastHistoryEntry = history.findLast(h => h.role === "assistant");
    if (!lastHistoryEntry) return;

    const disclaimer = document.createElement("p");
    disclaimer.className =
      "sn-ai-disclaimer m-1 mt-1.5 p-0 text-[var(--sl-color-gray-3)] opacity-60 text-[0.72rem] leading-relaxed italic animate-tools-in";
    disclaimer.textContent =
      "*AI can make mistakes, verify with included references";
    lastAssistant.append(disclaimer);
    appendActions(lastAssistant, lastHistoryEntry.content);
  }

  // ── Global document-level event delegation (registered once) ──
  if (!globalWindow.__slopnotesAIFabListener) {
    globalWindow.__slopnotesAIFabListener = true;
    document.addEventListener("click", (e) => {
      const fabBtn = (e.target as HTMLElement)?.closest?.("[data-ai-open]");
      if (fabBtn) {
        globalWindow.slopnotesAI?.open?.();
      }
    });
  }

  if (!globalWindow.__slopnotesAIKeyListener) {
    globalWindow.__slopnotesAIKeyListener = true;
    document.addEventListener("keydown", (event) => {
      const meta = event.ctrlKey || event.metaKey;
      if (meta && event.key.toLowerCase() === "i") {
        event.preventDefault();
        globalWindow.slopnotesAI?.toggle?.();
      }
      if (meta && event.key === "ArrowLeft") {
        globalWindow.slopnotesAI?.expand?.();
      }
      if (meta && event.key === "ArrowRight") {
        globalWindow.slopnotesAI?.minimize?.();
      }
      if (event.key === "Escape") {
        globalWindow.slopnotesAI?.close?.();
      }
    });
  }

  if (!globalWindow.__slopnotesAIThemeObserver) {
    globalWindow.__slopnotesAIThemeObserver = true;
    let themeTimer: number;
    new MutationObserver(() => {
      window.clearTimeout(themeTimer);
      themeTimer = window.setTimeout(() => {
        globalWindow.slopnotesAI?.rehighlight?.();
      }, 100);
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  }

  // ── Bootstrap initialization ──
  document.addEventListener("astro:page-load", () => void setupPage());
  document.addEventListener("astro:before-swap", teardownPage);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => void setupPage());
  } else {
    void setupPage();
  }

  // ── Panel open/close with CSS animation ──
  function setOpen(open: boolean) {
    if (
      !(panel instanceof HTMLElement) ||
      !(backdrop instanceof HTMLElement) ||
      !(fab instanceof HTMLElement)
    )
      return;
    isOpen = open;
    fab.setAttribute("aria-expanded", String(open));

    if (open) {
      fab.classList.add("is-hidden");
      panel.removeAttribute("hidden");
      backdrop.removeAttribute("hidden");
      // Force reflow for animation
      void panel.offsetHeight;
      requestAnimationFrame(() => {
        panel?.classList.add("is-visible");
        backdrop?.classList.add("is-visible");
      });
      panel.classList.toggle("is-expanded", isExpanded);
      document.documentElement.classList.add("sn-ai-open");
      startAuth();
      // Preload lazy modules (markdown-it and shiki) when the chat panel is opened
      void getMarkdown();
      void getHighlighter();
      setTimeout(() => input?.focus(), 120);
    } else {
      fab.classList.remove("is-hidden");
      panel.classList.remove("is-visible");
      backdrop.classList.remove("is-visible");
      document.documentElement.classList.remove("sn-ai-open");
      // Wait for exit animation
      const onEnd = () => {
        if (!isOpen && panel && backdrop) {
          panel.setAttribute("hidden", "");
          backdrop.setAttribute("hidden", "");
        }
        panel?.removeEventListener("transitionend", onEnd);
      };
      panel.addEventListener("transitionend", onEnd);
      // Fallback if transitionend doesn't fire
      setTimeout(() => {
        if (!isOpen && panel && backdrop) {
          panel.setAttribute("hidden", "");
          backdrop.setAttribute("hidden", "");
        }
      }, 600);
    }
  }

  function setExpanded(expanded: boolean) {
    isExpanded = expanded;
    panel?.classList.toggle("is-expanded", isExpanded);
    if (expandButton) {
      expandButton.title = isExpanded ? "Minimize" : "Expand";
      expandButton.setAttribute(
        "aria-label",
        isExpanded ? "Minimize chat window" : "Expand chat window",
      );
    }
    if (iconExpand instanceof SVGElement)
      iconExpand.style.display = isExpanded ? "none" : "";
    if (iconCollapse instanceof SVGElement)
      iconCollapse.style.display = isExpanded ? "" : "none";
  }

  function startNewChat() {
    cancelRequest();
    history = [];
    lastError = undefined;
    lastFailedMessage = undefined;
    hideFooterError();
    if (messages && empty) {
      messages
        .querySelectorAll("article")
        .forEach((node) => node.remove());
      empty.removeAttribute("hidden");
    }
    includeCurrentPage = false;
    thinkHarder = false;
    referenceButton?.classList.remove("is-active");
    referenceButton?.setAttribute("aria-pressed", "false");
    thinkButton?.classList.remove("is-active");
    thinkButton?.setAttribute("aria-pressed", "false");
    updateNewChatAvailability();
  }

  function cancelRequest() {
    if (controller) controller.abort();
    controller = undefined;
    streaming = false;
    requestSubmit = false;
    updateSendButton();
    updateInputState();
    showTyping(false);
  }

  // ── Typing indicator ──
  // Matches reference: delayed appearance, single phrase, simple show/hide.
  function showTyping(show: boolean) {
    if (typingAnimationTimer) {
      window.clearTimeout(typingAnimationTimer);
      typingAnimationTimer = undefined;
    }

    const indicator = typingIndicator;
    const label = typingLabel;
    const dots = typingDots;
    if (!indicator || !label || !dots) return;

    if (show) {
      // Pick ONE random phrase (reference behaviour — no cycling)
      const phrase = typingPhrases[Math.floor(Math.random() * typingPhrases.length)];
      const textNode = Array.from(label.childNodes).find(n => n.nodeType === Node.TEXT_NODE);
      if (textNode) {
        textNode.textContent = phrase;
      }

      startTypingDots();

      indicator.removeAttribute("hidden");
      indicator.classList.remove("sn-typing-exit");
      indicator.classList.add("sn-typing-enter");
      indicator.setAttribute("aria-hidden", "false");

      scrollMessages();
    } else {
      if (indicator.hasAttribute("hidden") && !indicator.classList.contains("sn-typing-exit")) {
        stopTypingDots();
        return;
      }

      indicator.classList.remove("sn-typing-enter");
      indicator.classList.add("sn-typing-exit");
      stopTypingDots();

      typingAnimationTimer = window.setTimeout(() => {
        indicator.setAttribute("hidden", "");
        indicator.classList.remove("sn-typing-exit");
        indicator.setAttribute("aria-hidden", "true");
        typingAnimationTimer = undefined;
      }, 700);
    }
  }

  function startTypingDots() {
    let dots = 1;
    window.clearInterval(typingDotTimer);
    if (typingDots instanceof HTMLElement) {
      typingDots.textContent = ".";
    }
    typingDotTimer = window.setInterval(() => {
      dots = dots >= 3 ? 1 : dots + 1;
      if (typingDots instanceof HTMLElement)
        typingDots.textContent = ".".repeat(dots);
    }, 250);
  }

  function stopTypingDots() {
    window.clearInterval(typingDotTimer);
    typingDotTimer = undefined;
  }

  // ── Verification / error status helpers ──
  function hideAllFooterStatus() {
    window.clearTimeout(verifyStatusTimer);
    window.clearTimeout(verifySlowTimer);
    window.clearTimeout(errorStatusTimer);
    verifyStatusTimer = undefined;
    verifySlowTimer = undefined;
    errorStatusTimer = undefined;

    window.clearInterval(verifyDotTimer);
    verifyDotTimer = undefined;

    if (verifyStatus instanceof HTMLElement) {
      verifyStatus.setAttribute("hidden", "");
      verifyStatus.classList.remove("sn-status-verify-enter", "sn-status-exit");
    }
    if (verifySlow instanceof HTMLElement) {
      verifySlow.setAttribute("hidden", "");
      verifySlow.classList.remove("sn-status-slow-enter", "sn-status-exit");
    }
    if (errorStatus instanceof HTMLElement) {
      errorStatus.setAttribute("hidden", "");
      errorStatus.classList.remove("sn-status-error-enter", "sn-status-exit");
    }
  }

  function showVerificationUI() {
    hideAllFooterStatus();

    let vdots = 1;
    if (verifyDots instanceof HTMLElement) verifyDots.textContent = ".";
    window.clearInterval(verifyDotTimer);
    verifyDotTimer = window.setInterval(() => {
      vdots = vdots >= 3 ? 1 : vdots + 1;
      if (verifyDots instanceof HTMLElement)
        verifyDots.textContent = ".".repeat(vdots);
    }, 250);

    if (verifyStatus instanceof HTMLElement) {
      verifyStatus.removeAttribute("hidden");
      verifyStatus.classList.add("sn-status-verify-enter");
      verifyStatus.setAttribute("aria-hidden", "false");
    }
    if (verifySlow instanceof HTMLElement) {
      verifySlow.removeAttribute("hidden");
      verifySlow.classList.add("sn-status-slow-enter");
      verifySlow.setAttribute("aria-hidden", "false");
    }
  }

  function hideVerificationUI() {
    window.clearInterval(verifyDotTimer);
    verifyDotTimer = undefined;

    const elapsed = authStartTime > 0 ? Date.now() - authStartTime : 0;
    authStartTime = 0;

    const status = verifyStatus;
    const slow = verifySlow;

    if (status) {
      status.classList.remove("sn-status-verify-enter");
      if (elapsed >= VERIFY_SHOW_DELAY_MS) {
        status.classList.add("sn-status-exit");
        verifyStatusTimer = window.setTimeout(() => {
          status.setAttribute("hidden", "");
          status.classList.remove("sn-status-exit");
          status.setAttribute("aria-hidden", "true");
          verifyStatusTimer = undefined;
        }, 700);
      } else {
        status.setAttribute("hidden", "");
        status.setAttribute("aria-hidden", "true");
      }
    }

    if (slow) {
      slow.classList.remove("sn-status-slow-enter");
      if (elapsed >= VERIFY_SLOW_DELAY_MS) {
        slow.classList.add("sn-status-exit");
        verifySlowTimer = window.setTimeout(() => {
          slow.setAttribute("hidden", "");
          slow.classList.remove("sn-status-exit");
          slow.setAttribute("aria-hidden", "true");
          verifySlowTimer = undefined;
        }, 700);
      } else {
        slow.setAttribute("hidden", "");
        slow.setAttribute("aria-hidden", "true");
      }
    }
  }

  function showFooterError(msg: string) {
    hideAllFooterStatus();
    lastError = msg;
    if (errorText instanceof HTMLElement) errorText.textContent = msg;
    if (errorStatus instanceof HTMLElement) {
      errorStatus.removeAttribute("hidden");
      errorStatus.classList.add("sn-status-error-enter");
      errorStatus.setAttribute("aria-hidden", "false");
    }
    attachLastAssistantMeta();
  }

  function hideFooterError() {
    lastError = undefined;
    const status = errorStatus;
    if (status) {
      status.classList.remove("sn-status-error-enter");
      status.classList.add("sn-status-exit");
      errorStatusTimer = window.setTimeout(() => {
        status.setAttribute("hidden", "");
        status.classList.remove("sn-status-exit");
        status.setAttribute("aria-hidden", "true");
        errorStatusTimer = undefined;
      }, 700);
    }
  }

  function updateNewChatAvailability() {
    if (newButton instanceof HTMLButtonElement) {
      newButton.disabled = streaming || history.length === 0;
      newButton.classList.toggle("is-disabled", newButton.disabled);
    }
  }

  function normalizeError(error: unknown) {
    if (typeof navigator !== "undefined" && !navigator.onLine) {
      return "You appear to be offline. Check your connection and try again.";
    }
    const message =
      error instanceof Error
        ? error.message
        : String(error || "Something went wrong.");
    if (message.includes("Failed to fetch"))
      return "The assistant is currently unavailable. Try again in a moment.";
    return message;
  }

  // ── Main ask submission flow matching reference ──
  async function ask(seed?: number) {
    if (!input || !messages || streaming || requestSubmit) return;

    const message = input.value.trim();
    if (!message) return;

    setOpen(true);
    hideFooterError();
    lastFailedMessage = undefined;

    // Start user submission waiting phase
    requestSubmit = true;
    pendingMessage = message;
    input.value = "";
    autoSize(input);
    updateInputState();
    updateSendButton();
    empty?.setAttribute("hidden", "");

    pendingUserBubble = await appendMessage("user", message);
    showTyping(true);

    startAuth();
    await checkAuthCompletion(seed);
  }

  async function checkAuthCompletion(seed?: number) {
    if (!requestSubmit) {
      if (powToken !== undefined && turnstileToken !== undefined) {
        hideVerificationUI();
      }
      return;
    }

    if (powToken === undefined || turnstileToken === undefined) {
      return;
    }

    hideVerificationUI();

    requestSubmit = false;
    updateInputState();

    if (powToken === null || turnstileToken === null) {
      showFooterError("Verification failed. Reload the page or try again.");
      if (pendingUserBubble instanceof HTMLElement) {
        pendingUserBubble.remove();
        pendingUserBubble = undefined;
      }
      showTyping(false);
      pendingMessage = undefined;
      return;
    }

    const messageToSend = pendingMessage || "";
    pendingMessage = undefined;
    pendingUserBubble = undefined;

    await runAskRequest(messageToSend, seed);
  }

  async function runAskRequest(message: string, seed?: number) {
    streaming = true;
    updateSendButton();
    updateInputState();

    history.push({ role: "user", content: message });
    updateNewChatAvailability();

    const assistantBubble = await appendMessage("assistant", "");
    const assistantContent = assistantBubble.querySelector(".sn-ai-markdown");
    if (assistantBubble instanceof HTMLElement) {
      assistantBubble.style.display = "none";
    }
    controller = new AbortController();

    let streamed = "";
    let gotFirstChunk = false;
    try {
      const body = {
        pow: powToken ? { suffix: powToken } : undefined,
        message: message.slice(0, 4096),
        history: history
          .slice(-9, -1)
          .slice(-8)
          .map(({ role, content, checksum }) => ({ role, content, checksum })),
        ...(thinkHarder ? { think: true } : {}),
        ...(includeCurrentPage ? { reference: currentReference() } : {}),
        ...(seed !== undefined ? { seed } : {}),
      };

      const response = await fetch(`${apiBase}/ask`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          ...(turnstileToken ? { "x-turnstile-token": turnstileToken } : {}),
        },
        credentials: "include",
        body: JSON.stringify(body),
        signal: controller.signal,
      });

      if (!response.ok || !response.body) {
        const text = await response.text().catch(() => "");
        throw new Error(text || `HTTP ${response.status}`);
      }

      const reader = response.body.getReader();
      const decoder = new TextDecoder();

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        if (!gotFirstChunk) {
          gotFirstChunk = true;
          showTyping(false);
          if (assistantBubble instanceof HTMLElement) {
            assistantBubble.style.display = "";
          }
          triggerHaptic(18);
        }

        streamed += decoder.decode(value, { stream: true });
        
        if (assistantContent instanceof HTMLElement) {
          const md = markdownInstance || (await getMarkdown());
          assistantContent.innerHTML = renderMarkdownHtml(md, stripMetadata(streamed).content);
          smartScroll();
          await new Promise((resolve) => setTimeout(resolve, 16));
        }
      }

      streamed += decoder.decode();
      const parsed = stripMetadata(streamed);
      const finalContent =
        parsed.content.trim() ||
        "No answer came back. Try rephrasing your question.";
      await renderFinalMarkdown(assistantContent, finalContent);
      triggerHaptic(28);

      history.push({
        role: "assistant",
        content: finalContent,
        checksum: parsed.checksum,
      });
      updateNewChatAvailability();
    } catch (error) {
      if (error instanceof DOMException && error.name === "AbortError") return;
      showTyping(false);
      // Remove empty assistant bubble on error
      if (assistantBubble instanceof HTMLElement) {
        assistantBubble.remove();
      }
      const msg = normalizeError(error);
      lastFailedMessage = message;
      showFooterError(msg);
    } finally {
      streaming = false;
      controller = undefined;
      updateSendButton();
      updateInputState();
      showTyping(false);
      attachLastAssistantMeta();
      resetAuth();
    }
  }

  async function appendMessage(role: HistoryItem["role"], content: string) {
    const article = document.createElement("article");
    article.className = `w-full mb-3 flex flex-col animate-msg-in sn-role-${role} ${role === "user" ? "items-end origin-top-right" : "items-start origin-top-left"}`;

    const bubble = document.createElement("div");
    if (role === "user") {
      bubble.className =
        "max-w-[85%] rounded-2xl px-3.5 py-2 text-sm text-[var(--sl-color-white)] bg-[color-mix(in_srgb,var(--sl-color-accent)_9%,var(--sl-color-gray-6))] border border-[color-mix(in_srgb,var(--sl-color-accent)_15%,var(--sl-color-gray-5))] shadow-sm leading-relaxed whitespace-pre-wrap";
      const inner = document.createElement("div");
      inner.textContent = content;
      bubble.append(inner);
    } else {
      bubble.className = "w-full pt-1 px-1";
      const inner = document.createElement("div");
      inner.className =
        "sn-ai-markdown text-sm leading-relaxed text-[color-mix(in_srgb,var(--sl-color-white)_82%,transparent)]";
      bubble.append(inner);
      if (content) {
        await renderMarkdown(inner, content);
      }
    }

    article.append(bubble);
    if (messages) {
      if (typingIndicator) {
        messages.insertBefore(article, typingIndicator);
      } else {
        messages.append(article);
      }
    }
    scrollMessages();
    return article;
  }

  function appendActions(messageEl: HTMLElement, content: string) {
    const bar = document.createElement("div");
    bar.className =
      "sn-ai-actions flex items-center gap-1 mt-1.5 animate-tools-in text-[var(--sl-color-gray-3)]";

    const jumpBtn = document.createElement("button");
    jumpBtn.type = "button";
    jumpBtn.className =
      "size-7 rounded-md grid place-items-center bg-transparent cursor-pointer hover:bg-[color-mix(in_srgb,var(--sl-color-accent)_13%,transparent)] hover:text-[color-mix(in_srgb,var(--sl-color-accent)_80%,var(--sl-color-white))] active:scale-90 transition-all duration-150";
    jumpBtn.title = "Jump to response";
    jumpBtn.innerHTML = `<svg class="size-3.5" viewBox="0 0 24 24" fill="none"><path d="M12 19V5M6 11l6-6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    jumpBtn.addEventListener("click", () => {
      if (messages) {
        messages.scrollTo({
          top: Math.max(0, messageEl.offsetTop - messages.clientHeight / 3),
          behavior: "smooth",
        });
      }
    });
    bar.append(jumpBtn);

    // Copy button
    const copyBtn = document.createElement("button");
    copyBtn.type = "button";
    copyBtn.className =
      "size-7 rounded-md grid place-items-center bg-transparent cursor-pointer hover:bg-[color-mix(in_srgb,var(--sl-color-accent)_13%,transparent)] hover:text-[color-mix(in_srgb,var(--sl-color-accent)_80%,var(--sl-color-white))] active:scale-90 transition-all duration-150";
    copyBtn.title = "Copy to clipboard";
    copyBtn.innerHTML = `<svg class="size-3.5" viewBox="0 0 24 24" fill="none"><rect x="9" y="9" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`;
    copyBtn.addEventListener("click", () => {
      navigator.clipboard.writeText(content).then(() => {
        copyBtn.classList.add(
          "text-[color-mix(in_srgb,var(--sl-color-accent)_82%,var(--sl-color-white))]",
        );
        copyBtn.innerHTML = `<svg class="size-3.5" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
        setTimeout(() => {
          copyBtn.classList.remove(
            "text-[color-mix(in_srgb,var(--sl-color-accent)_82%,var(--sl-color-white))]",
          );
          copyBtn.innerHTML = `<svg class="size-3.5" viewBox="0 0 24 24" fill="none"><rect x="9" y="9" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`;
        }, 2000);
      });
    });
    bar.append(copyBtn);

    // Regenerate button
    const regenBtn = document.createElement("button");
    regenBtn.type = "button";
    regenBtn.className =
      "size-7 rounded-md grid place-items-center bg-transparent cursor-pointer hover:bg-[color-mix(in_srgb,var(--sl-color-accent)_13%,transparent)] hover:text-[color-mix(in_srgb,var(--sl-color-accent)_80%,var(--sl-color-white))] active:scale-90 transition-all duration-150";
    regenBtn.title = "Regenerate";
    regenBtn.innerHTML = `<svg class="size-3.5" viewBox="0 0 24 24" fill="none"><path d="M1 4v6h6M23 20v-6h-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    regenBtn.addEventListener("click", () => {
      if (streaming) return;
      // Find last user message
      const lastUserIdx = history.length - 2;
      if (lastUserIdx < 0) return;
      const lastUserMsg = history[lastUserIdx].content;
      // Remove last assistant + user from history
      history.splice(lastUserIdx, 2);
      updateNewChatAvailability();
      // Remove the message elements
      const allMsgs = messages?.querySelectorAll("article");
      if (allMsgs && allMsgs.length >= 2) {
        allMsgs[allMsgs.length - 1].remove();
        allMsgs[allMsgs.length - 2].remove();
      }
      // Re-ask
      if (input) {
        input.value = lastUserMsg;
        autoSize(input);
        const randomSeed = ~~(Math.random() * 2000000);
        void ask(randomSeed);
      }
    });
    bar.append(regenBtn);

    messageEl.append(bar);
  }

  async function renderMarkdown(target: Element | null, source: string) {
    if (!(target instanceof HTMLElement)) return;
    const md = await getMarkdown();
    target.innerHTML = renderMarkdownHtml(md, source);
  }

  async function renderFinalMarkdown(target: Element | null, source: string) {
    if (!(target instanceof HTMLElement)) return;
    const md = await getMarkdown();
    target.innerHTML = renderMarkdownHtml(md, source);
    await highlightCodeBlocks(target);
  }

  function renderMarkdownHtml(md: any, source: string) {
    const citations: string[] = [];
    const withPlaceholders = source.replace(
      /【([^】]+)】/g,
      (_, title: string) => {
        const index = citations.push(title) - 1;
        return ` @@SN_CITATION_${index}@@`;
      },
    );
    let html = md.render(withPlaceholders);
    html = html.replace(
      /@@SN_CITATION_(\d+)@@/g,
      (_: string, rawIndex: string) => {
        const title = citations[Number(rawIndex)] || "Reference";
        const safeTitle = escapeHtml(title);
        return `<span class="sn-ai-citation" title="Reference: ${safeTitle}">${safeTitle}</span>`;
      },
    );
    
    // Wrap tables for responsive horizontal scrolling
    html = html.replace(/<table([^>]*)>/g, '<div class="overflow-x-auto my-4 w-full"><table$1>');
    html = html.replace(/<\/table>/g, '</table></div>');
    
    return html;
  }

  async function highlightCodeBlocks(target: HTMLElement) {
    const blocks = Array.from(
      target.querySelectorAll<HTMLElement>("[data-sn-code-block]"),
    );
    if (!blocks.length) return;

    let highlighterData;
    try {
      highlighterData = await getHighlighter();
    } catch {
      return;
    }
    const { highlighter, addCopyButton } = highlighterData;

    for (const block of blocks) {
      const code = block.querySelector("pre code");
      if (!(code instanceof HTMLElement)) continue;
      const raw = code.textContent || "";
      const lang = normalizeLanguage(block.dataset.lang || "text");
      const displayLang = lang === "text" ? "txt" : lang;
      let highlighted = "";
      try {
        highlighted = highlighter.codeToHtml(raw.replace(/\n$/, ""), {
          lang,
          theme: currentShikiTheme(),
          transformers: [addCopyButton({ toggle: 2000 })],
        });
      } catch {
        highlighted = highlighter.codeToHtml(raw.replace(/\n$/, ""), {
          lang: "text",
          theme: currentShikiTheme(),
          transformers: [addCopyButton({ toggle: 2000 })],
        });
      }
      block.innerHTML = `<div class="flex items-center justify-end min-h-8 px-4 border-b border-[var(--sn-ai-code-border)]/50 text-[var(--sn-ai-code-header-text)] font-mono text-[0.66rem] tracking-wider uppercase"><span>${escapeHtml(displayLang)}</span></div>${highlighted}`;
    }
  }

  function getHighlighter() {
    if (highlighterPromise) return highlighterPromise;

    highlighterPromise = Promise.all([
      import("shiki"),
      import("shiki-transformer-copy-button"),
    ]).then(([{ createHighlighter }, { addCopyButton }]) => {
      return createHighlighter({
        themes: ["catppuccin-mocha", "catppuccin-latte"],
        langs: shikiLanguages,
      }).then((highlighter) => {
        return { highlighter, addCopyButton };
      });
    });

    return highlighterPromise;
  }

  function currentShikiTheme() {
    return document.documentElement.dataset.theme === "light"
      ? "catppuccin-latte"
      : "catppuccin-mocha";
  }

  function normalizeLanguage(lang: string) {
    const normalized = lang.toLowerCase().replace(/[^a-z0-9+#-]/g, "");
    const aliases: Record<string, string> = {
      "": "text",
      txt: "text",
      plaintext: "text",
      md: "markdown",
      sh: "bash",
      shell: "bash",
      zsh: "bash",
      yml: "yaml",
      docker: "dockerfile",
      js: "javascript",
      ts: "typescript",
      py: "python",
      kt: "kotlin",
    };
    return aliases[normalized] || normalized || "text";
  }

  // trigger haptic
  function triggerHaptic(duration = 20) {
    if ("vibrate" in navigator) navigator.vibrate(duration);
  }

  function stripMetadata(content: string): {
    content: string;
    checksum?: string;
  } {
    const index = content.indexOf(metadataSeparator);
    if (index === -1) return { content };
    const metadata = content.slice(index + metadataSeparator.length);
    return {
      content: content.slice(0, index),
      checksum: /checksum:(\w+)/g.exec(metadata)?.[1]?.trim(),
    };
  }

  function currentReference() {
    const pathname = window.location.pathname
      .replace(/\/$/, "")
      .replace(/^\//, "");
    return decodeURIComponent(pathname || "index");
  }

  // ── Smart scroll: only auto-scroll if user is near the bottom ──
  function smartScroll() {
    if (!(messages instanceof HTMLElement)) return;
    const { scrollTop, scrollHeight, clientHeight } = messages;
    if (window.innerHeight * 1.5 > scrollHeight) return;
    if (scrollTop > scrollHeight - clientHeight * 1.5) {
      messages.scrollTop = scrollHeight;
    }
  }

  function startAuth() {
    if (authStarted) return;
    authStarted = true;
    powToken = undefined;
    if (turnstileSiteKey) {
      turnstileToken = undefined;
    } else {
      turnstileToken = "dev-bypass";
    }

    authStartTime = Date.now();
    showVerificationUI();

    if (powWorker) {
      powWorker.terminate();
      powWorker = null;
    }

    powWorker = createPowWorker();
    if (powWorker) {
      powWorker.onmessage = (e) => {
        if (e.data.error) {
          powToken = null;
        } else {
          powToken = e.data.suffix;
        }
        powWorker?.terminate();
        powWorker = null;
        updateSendButton();
        checkAuthCompletion();
      };
      powWorker.postMessage({ apiBase });
    } else {
      solvePowMainThread()
        .then((suffix) => {
          powToken = suffix;
          updateSendButton();
          checkAuthCompletion();
        })
        .catch(() => {
          powToken = null;
          updateSendButton();
          checkAuthCompletion();
        });
    }
    loadTurnstile();
  }

  function resetAuth() {
    authStarted = false;
    powToken = undefined;
    if (turnstileSiteKey) {
      turnstileToken = undefined;
      try {
        globalWindow.turnstile?.reset?.();
      } catch {
        // ignore if elements destroyed
      }
    }
    startAuth();
  }

  async function solvePowMainThread() {
    const response = await fetch(`${apiBase}/pow/request`, {
      credentials: "include",
    });
    if (!response.ok) throw new Error("PoW request failed");
    const challenge = await response.json();
    const target = "0".repeat(Math.floor(Number(challenge.bits || 0) / 4));
    let suffix = 0;
    while (true) {
      const hash = await sha256Hex(`${challenge.nonce}:${suffix}`);
      if (hash.startsWith(target)) return String(suffix);
      suffix++;
      if (suffix % 500 === 0) await delay(0);
    }
  }

  function loadTurnstile() {
    if (!turnstileSiteKey || !(turnstileHost instanceof HTMLElement)) return;

    globalWindow.slopnotesTurnstileCallback = (token: string) => {
      turnstileToken = token || null;
      updateSendButton();
      checkAuthCompletion();
    };
    turnstileHost.className =
      "cf-turnstile absolute w-px h-px overflow-hidden opacity-[0.01] pointer-events-none";
    turnstileHost.setAttribute("data-sitekey", turnstileSiteKey);
    turnstileHost.setAttribute("data-callback", "slopnotesTurnstileCallback");

    if (globalWindow.turnstile?.render) {
      try {
        globalWindow.turnstile.render(turnstileHost, {
          sitekey: turnstileSiteKey,
          callback: "slopnotesTurnstileCallback",
        });
        return;
      } catch {
        // if already rendered or error
      }
    }

    if (document.getElementById("sn-ai-turnstile-script")) return;
    const script = document.createElement("script");
    script.id = "sn-ai-turnstile-script";
    script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
    script.async = true;
    script.defer = true;
    document.head.append(script);
  }

  function updateSendButton() {
    const authReady = !!(turnstileToken && powToken);
    sendButton?.classList.toggle("is-streaming", streaming);
    if (sendButton instanceof HTMLButtonElement) {
      // Disable send while auth isn't ready or while waiting to submit
      sendButton.disabled = (!streaming && !authReady) || requestSubmit;
      if (streaming) {
        sendButton.title = "Stop response";
        sendButton.setAttribute("aria-label", "Stop response");
      } else if (requestSubmit || !authReady) {
        sendButton.title = powToken === null || turnstileToken === null
          ? "Verification failed, please refresh the page."
          : "Verifying that you're a human...";
        sendButton.setAttribute("aria-label", sendButton.title);
      } else {
        sendButton.title = "Send message";
        sendButton.setAttribute("aria-label", "Send message");
      }
    }
    if (sendIcon instanceof SVGElement)
      sendIcon.style.display = streaming ? "none" : "";
    if (stopIcon instanceof SVGElement)
      stopIcon.style.display = streaming ? "" : "none";
    updateNewChatAvailability();
  }

  function updateInputState() {
    if (!input) return;
    const disabled = streaming || requestSubmit;
    input.disabled = disabled;
    input.classList.toggle("is-disabled", disabled);
    if (disabled) {
      input.placeholder = "";
    } else {
      input.placeholder = "What's on your mind?";
    }
  }

  function autoSize(element: HTMLTextAreaElement) {
    element.style.height = "auto";
    element.style.height = `${Math.min(element.scrollHeight, 150)}px`;
  }

  async function sha256Hex(value: string) {
    const digest = await crypto.subtle.digest(
      "SHA-256",
      new TextEncoder().encode(value),
    );
    return Array.from(new Uint8Array(digest))
      .map((byte) => byte.toString(16).padStart(2, "0"))
      .join("");
  }

  function scrollMessages() {
    if (messages instanceof HTMLElement)
      messages.scrollTo({ top: messages.scrollHeight, behavior: "smooth" });
  }

  function sanitizeHref(href: string) {
    try {
      const url = new URL(href, window.location.origin);
      if (!["http:", "https:", "mailto:"].includes(url.protocol)) return "#";
      return escapeHtml(url.href);
    } catch {
      return "#";
    }
  }

  // Escape HTML helper
  function escapeHtml(value: string) {
    const entities: Record<string, string> = {
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      "'": "&#39;",
      '"': "&quot;",
    };
    return value.replace(/[&<>'"]/g, (char) => entities[char] || char);
  }

  function delay(ms: number) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }
</script>

