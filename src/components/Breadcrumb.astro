---
const url = Astro.url;
const pathSegments = url.pathname.split("/").filter((segment) => segment);
const breadcrumbItems = pathSegments.map((segment, index) => {
  const href = "/" + pathSegments.slice(0, index + 1).join("/");
  const text = decodeURIComponent(segment.replace(/-/g, " "));
  return { href, text };
});
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    {
      breadcrumbItems.map((item, index) => (
        <li>
          {index < breadcrumbItems.length - 1 ? (
            <a href={item.href}>{item.text}</a>
          ) : (
            <span aria-current="page">{item.text}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  /* Self-contained + UNLAYERED on purpose: unlayered author CSS beats every
     cascade layer (Starlight base/reset/core/content, Tailwind theme/utils),
     so no global or prose list reset can re-number this nav. Every selector
     is `.breadcrumb`-qualified; do not move these into a `@layer`. */
  .breadcrumb {
    /* Align with content padding; fixed gutters overflowed 360px viewports
       and misaligned with the prose column. */
    padding: 0 var(--sl-content-pad-x, 1rem);
    margin-bottom: 0.4rem;
    min-width: 0;
    background: none;
  }
  .breadcrumb ol {
    list-style: none;
    list-style-type: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.15rem;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--sl-color-white) 78%, transparent);
    min-width: 0;
  }
  .breadcrumb li {
    list-style: none;
    list-style-type: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    min-width: 0;
    max-width: 100%;
    position: relative;
    text-transform: capitalize;
  }
  /* Guard: even if a future reset re-enables markers, this nav shows none. */
  .breadcrumb li::marker {
    content: none;
  }
  /* The current page takes remaining space and ellipsis instead of
     pushing siblings off-screen at 360px. */
  .breadcrumb li:last-child {
    flex: 1 1 6rem;
    color: var(--sl-color-white);
  }
  .breadcrumb li::after {
    content: '/';
    display: inline-block;
    flex-shrink: 0;
    margin-left: 0.5rem;
    margin-right: 0.5rem;
    color: color-mix(in srgb, var(--sl-color-white) 64%, transparent);
  }

  .breadcrumb li:last-child::after {
    display: none;
  }
  .breadcrumb a,
  .breadcrumb li > span {
    display: inline-block;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: bottom;
  }
  .breadcrumb a {
    color: inherit;
    text-decoration: none;
    border-radius: 0.25rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .breadcrumb a:hover {
      color: var(--sl-color-white);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
  .breadcrumb a:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    outline-offset: 2px;
  }
  /* 44px-ish link rows on coarse pointers; desktop keeps tight rhythm. */
  @media (pointer: coarse) {
    .breadcrumb a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
