---
import config from "@/config/config.json" with { type: "json" };
import { markdownify } from "@/lib/utils/textConverter";
import { getTranslations } from "@/lib/utils/languagePerser";

const locale = Astro.currentLocale;

const menu = await getTranslations(locale || "en");

const footer = menu.footer;
---

<footer>
  <div class="container">
    <div class="top-footer">
      {
        footer.community && (
          <div>
            <h4>{footer.community.title}</h4>
            <ul>
              {footer.community?.links.map((link: any) => (
                <li>
                  <a href={link.url}>{link.name}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        footer.help_links && (
          <div>
            <h4>{footer.help_links.title}</h4>
            <ul>
              {footer.help_links?.links.map((link: any) => (
                <li>
                  <a href={link.url}>{link.name}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        footer.company && (
          <div>
            <h4>{footer.company.title}</h4>
            <ul>
              {footer.company?.links.map((link: any) => (
                <li>
                  <a href={link.url}>{link.name}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
    <div class="bottom-footer">
      <p set:html={markdownify(config?.params?.copyright)} />
    </div>
  </div>
</footer>

<style>
  @layer starlight.core {
    footer {
      border-top: 1px solid var(--border);
    }
    .top-footer {
      padding: 4rem 0;
      display: grid;
      gap: 2.5rem;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
    .top-footer h4 {
      font-size: 0.75rem !important;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted-foreground);
      margin-bottom: 1rem;
    }
    .top-footer ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .top-footer ul li {
      margin-bottom: 0.75rem;
    }
    .top-footer ul li:last-child {
      margin-bottom: 0;
    }
    .top-footer ul li a {
      color: var(--muted-foreground);
      text-decoration: none;
      font-size: 0.875rem;
      text-underline-offset: 0.2em;
      transition: color 0.2s ease;
    }
    .top-footer ul li a:hover {
      color: var(--foreground);
      text-decoration: underline;
    }

    .bottom-footer {
      padding: 1.5rem 0;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      font-size: 0.8125rem;
      color: var(--muted-foreground);
    }
    .bottom-footer a {
      color: var(--muted-foreground);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .bottom-footer a:hover {
      color: var(--foreground);
    }
  }
</style>
