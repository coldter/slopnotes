---
const { toc, isMobile = false, depth = 0 } = Astro.props;
---

<ul class:list={{ isMobile }}>
  {
    toc.map((heading: { slug: string; text: string; children: any[] }) => (
      <li>
        <a href={"#" + heading.slug}>
          <span>{heading.text}</span>
        </a>
        {heading.children.length > 0 && (
          <Astro.self
            toc={heading.children}
            depth={depth + 1}
            isMobile={isMobile}
          />
        )}
      </li>
    ))
  }
</ul>

<style define:vars={{ depth }}>
  @layer starlight.core {
    ul {
      padding: 0;
      list-style: none;
      /* Nesting indent token: 0 at the top level (depth-0 labels align with the
         rail heading, as the reference zeroes inline-start there), 0.5rem once
         nested (see the `ul > li > ul` rule). */
      --pad-inline: 0rem;
    }
    a {
      display: block;
      padding-inline: calc(0.25rem * var(--depth) + var(--pad-inline))
        var(--pad-inline);
      /* 24px rows: a 1rem line box plus the 0.25rem block padding. */
      padding-block: 0.25rem;
      border-radius: 0.25rem;
      font-size: 0.875rem;
      font-weight: 400;
      line-height: 1rem;
      text-decoration: none;
      color: var(--muted-foreground);
    }
    a:focus-visible {
      outline: 2px solid var(--ring);
      outline-offset: 2px;
    }
    @media (hover: hover) and (pointer: fine) {
      a:hover {
        color: color-mix(in oklab, var(--foreground) 72%, var(--muted-foreground));
      }
    }
    a[aria-current="true"] {
      color: var(--foreground);
      font-weight: 500;
    }
    ul > li > ul {
      --pad-inline: 0.5rem;
      margin-top: 0.5rem;
      padding-inline: calc((1rem - var(--pad-inline)) / var(--depth) + var(--pad-inline))
        var(--pad-inline);
    }
    .isMobile a {
      --pad-inline: 1rem;
      display: flex;
      justify-content: space-between;
      gap: var(--pad-inline);
      border-top: 1px solid var(--border);
      border-radius: 0;
      padding-block: 0.5rem;
      color: var(--foreground);
      font-size: var(--sl-text-sm);
      text-decoration: none;
      outline-offset: var(--sl-outline-offset-inside);
    }
    .isMobile:first-child > li:first-child > a {
      border-top: 0;
    }
    /* 44px-ish rows on coarse pointers; desktop density untouched. */
    @media (pointer: coarse) {
      a {
        min-height: 44px;
        padding-block: 0.65rem;
      }
      .isMobile a {
        padding-block: 0.75rem;
      }
    }
    .isMobile a[aria-current="true"],
    .isMobile a[aria-current="true"]:hover,
    .isMobile a[aria-current="true"]:focus {
      /* Higher specificity than `.isMobile a` so current stays legible. */
      color: var(--foreground);
    }
    .isMobile a[aria-current="true"]::after {
      content: "";
      width: 1rem;
      background-color: var(--foreground);
      /* Check mark SVG icon */
      -webkit-mask-image: url("data:image/svg+xml;base64,");
      mask-image: url("data:image/svg+xml;base64,");
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      flex-shrink: 0;
    }
  }
</style>
