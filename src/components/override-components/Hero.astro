---
import Search from "./Search.astro";
import { Icon } from "@astrojs/starlight/components";
import FeaturedGuides from "../FeaturedGuides.astro";
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};

// check if 404 page
const is404 = Astro.locals.starlightRoute?.id === "404";
// the site landing page (root index) gets the branded treatment + guide grid
const isHome = Astro.locals.starlightRoute?.id === "";
---

<div
  class="hero flex flex-col items-center mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12"
>
  {isHome && <span class="hero-kicker">&gt;_ AI-generated learning notes</span>}
  {
    isHome ? (
      <h1 class="brand-title mb-8 text-center">
        <span class="b-slop">slop</span><span class="b-notes">notes</span>
      </h1>
    ) : (
      title && <h1 set:html={title} class="mb-8 text-center rounded-2xl" />
    )
  }
  {tagline && <p set:html={tagline} class="tagline text-center" />}

  {
    !is404 && (
      <div class="mt-8 max-w-4xl">
        <div class="search-container rounded-2xl p-2 mb-6">
          <div class="search-bar">
            <Search />
          </div>
        </div>

        <div class="flex justify-center">
          <a class="browse-cta no-underline" href="/content/">
            <span>Browse content</span>
            <Icon name="right-arrow" size="1.1rem" />
          </a>
        </div>
      </div>
    )
  }
</div>

{isHome && <FeaturedGuides />}

<style>
  @layer starlight.core {
    .hero-kicker {
      display: inline-block;
      margin-bottom: 1.1rem;
      font-family: var(--__sl-font-mono, ui-monospace, monospace);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted-foreground);
    }

    .brand-title {
      font-family: var(--__sl-font-mono, ui-monospace, "JetBrains Mono", monospace);
      font-size: clamp(2.5rem, 1.6rem + 4vw, 4rem);
      line-height: 1;
      letter-spacing: -0.02em;
      font-weight: 700;
      text-wrap: balance;
    }
    .brand-title .b-slop {
      color: var(--brand);
    }
    .brand-title .b-notes {
      color: var(--foreground);
    }

    h1 {
      font-size: clamp(2.25rem, 1.6rem + 3vw, 3.25rem);
      line-height: 1.08;
      letter-spacing: -0.025em;
      font-weight: 600;
      font-family: var(--font-primary);
      color: var(--foreground);
      text-wrap: balance;
    }

    .tagline {
      max-width: 36rem;
      margin-top: 1rem;
      margin-inline: auto;
      font-size: 1.1875rem;
      line-height: 1.6;
      text-wrap: pretty;
      color: var(--muted-foreground);
    }

    .search-container {
      width: min(100%, 42rem);
      margin: auto;
      background: var(--muted);
      border: 0;
      border-radius: var(--radius);
      box-shadow: none;
      transition: box-shadow 180ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    .search-container:focus-within {
      box-shadow: 0 0 0 3px var(--focus-ring);
    }

    .browse-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--primary);
      border-radius: var(--radius);
      height: 2rem;
      padding: 0 1rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--primary-foreground);
      transition: background-color 160ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    .browse-cta:focus-visible {
      box-shadow: 0 0 0 3px var(--focus-ring);
    }
    @media (hover: hover) and (pointer: fine) {
      .browse-cta:hover {
        background: color-mix(in oklab, var(--primary) 88%, var(--background));
      }
      .browse-cta:hover :global(svg) {
        transform: translateX(3px);
      }
    }
    .browse-cta :global(svg) {
      transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    .browse-cta:focus-visible :global(svg) {
      transform: translateX(3px);
    }

    @media (max-width: 940px) {
      h1 {
        font-size: 2.25rem;
        line-height: 1.1;
        letter-spacing: -0.02em;
      }
      .tagline {
        font-size: 1.0625rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .browse-cta,
      .browse-cta :global(svg),
      .search-container {
        transition: none;
      }
      .browse-cta:hover :global(svg),
      .browse-cta:focus-visible :global(svg) {
        transform: none;
      }
      .hero {
        animation: none;
      }
    }
  }
</style>
<script>
  const iconElements = document.querySelector("[data-icon-path]");

  // make image element and add the path to src
  if (iconElements) {
    const iconPath = iconElements.getAttribute("data-icon-path");

    const img = document.createElement("img");
    img.src = `/${iconPath}` || "";
    img.alt = "icon";
    img.className = "hidden lg:inline-block size-20 -mb-2 rounded-2xl";
    iconElements.replaceWith(img);
  }
</script>
