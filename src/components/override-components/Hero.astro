---
import Search from "./Search.astro";
import { Icon } from "@astrojs/starlight/components";
import FeaturedGuides from "../FeaturedGuides.astro";
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};

// check if 404 page
const is404 = Astro.locals.starlightRoute?.id === "404";
// the site landing page (root index) gets the branded treatment + guide grid
const isHome = Astro.locals.starlightRoute?.id === "";
---

<div
  class="hero flex flex-col items-center mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-20"
>
  {isHome && <span class="hero-kicker">&gt;_ AI-generated learning notes</span>}
  {
    isHome ? (
      <h1 class="brand-title mb-8 text-center">
        <span class="b-slop">slop</span><span class="b-notes">notes</span>
      </h1>
    ) : (
      title && <h1 set:html={title} class="mb-8 text-center rounded-2xl" />
    )
  }
  {tagline && <p set:html={tagline} class="tagline text-center" />}

  {
    !is404 && (
      <div class="mt-12 max-w-4xl">
        <div class="search-container rounded-2xl p-2 mb-6">
          <div class="search-bar">
            <Search />
          </div>
        </div>

        <div class="flex justify-center">
          <a class="browse-cta no-underline" href="/content/">
            <span>Browse content</span>
            <Icon name="right-arrow" size="1.1rem" />
          </a>
        </div>
      </div>
    )
  }
</div>

{isHome && <FeaturedGuides />}

<style>
  @layer starlight.core {
    .hero-kicker {
      display: inline-block;
      margin-bottom: 1.1rem;
      padding: 0.3rem 0.8rem;
      border: 1px solid color-mix(in srgb, var(--sl-color-accent) 35%, transparent);
      border-radius: 9999px;
      background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
      font-family: var(--__sl-font-mono, ui-monospace, monospace);
      font-size: 0.8125rem;
      letter-spacing: 0.01em;
      color: color-mix(in srgb, var(--sl-color-accent) 90%, var(--sl-color-white));
    }

    .brand-title {
      font-family: var(--__sl-font-mono, ui-monospace, "JetBrains Mono", monospace);
      font-size: clamp(2.5rem, 1.6rem + 4vw, 4rem);
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 700;
    }
    .brand-title .b-slop {
      color: var(--sl-color-accent);
    }
    .brand-title .b-notes {
      color: var(--sl-color-white);
    }

    h1 {
      font-size: clamp(2.25rem, 1.6rem + 3vw, 3.25rem);
      line-height: 1.08;
      letter-spacing: -0.025em;
      font-weight: 600;
      font-family: var(--font-primary);
      color: var(--sl-color-white);
    }

    .tagline {
      max-width: 36rem;
      margin-top: 1rem;
      margin-inline: auto;
      font-size: 1.1875rem;
      line-height: 1.5;
      color: color-mix(in srgb, var(--sl-color-white) 78%, transparent);
    }

    .search-container {
      width: 90%;
      margin: auto;
      background: var(--sl-color-black);
      border: 1px solid var(--sl-color-hairline);
      border-radius: 14px;
      box-shadow: none;
    }

    .browse-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--color-primary-gradient);
      border-radius: 9999px;
      padding: 0.6rem 1.4rem;
      font-size: 0.9375rem;
      font-weight: 600;
      color: #fff;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        filter 0.15s ease;
    }
    .browse-cta:hover,
    .browse-cta:focus-visible {
      transform: translateY(-2px);
      filter: brightness(1.05);
      box-shadow: 0 6px 18px color-mix(in srgb, var(--sl-color-accent) 35%, transparent);
    }
    .browse-cta :global(svg) {
      transition: transform 0.15s ease;
    }
    .browse-cta:hover :global(svg) {
      transform: translateX(3px);
    }

    @media (max-width: 940px) {
      h1 {
        font-size: 2.25rem;
        line-height: 1.1;
        letter-spacing: -0.02em;
      }
      .search-container {
        width: 100%;
      }
    }
  }
</style>
<script>
  const iconElements = document.querySelector("[data-icon-path]");
  const heroSection = document.querySelector(".hero");
  const header = document.querySelector(".header");
  const heroBG = document.querySelector(".hero-bg") as HTMLElement;

  const totalHeight =
    (heroSection?.clientHeight || 0) + (header?.clientHeight || 0) + 24;

  heroBG.style.height = `${totalHeight}px`;

  // make image element and add the path to src
  if (iconElements) {
    const iconPath = iconElements.getAttribute("data-icon-path");

    const img = document.createElement("img");
    img.src = `/${iconPath}` || "";
    img.alt = "icon";
    img.className =
      "hidden lg:inline-block size-20 -mb-2 rounded-2xl animate-[bounce_2s_ease-in-out_infinite]";
    iconElements.replaceWith(img);
  }
</script>
