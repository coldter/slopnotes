---
import Search from "./Search.astro";
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};
const { sidebar } = Astro.locals.starlightRoute;

function getFirstHref(item: any): string | null {
  if (typeof item?.href === "string" && item.href) {
    return item.href;
  }
  if (item?.entries && Array.isArray(item.entries) && item.entries.length > 0) {
    return getFirstHref(item.entries[0]);
  }
  return null; // No valid href found
}

// check if 404 page
const is404 = Astro.locals.starlightRoute?.id === "404";
---

<div
  class="hero flex flex-col items-center mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-20"
>
  {title && <h1 set:html={title} class="mb-8 text-center rounded-2xl" />}
  {tagline && <p set:html={tagline} class="tagline text-center" />}

  {
    !is404 && (
      <div class="mt-12 max-w-4xl">
        <div class="search-container rounded-2xl p-2 mb-6">
          <div class="search-bar">
            <Search />
          </div>
        </div>

        <div class="flex justify-center items-center flex-wrap gap-3">
          <p class="popular-label font-normal">
            {Astro.locals.t("hero.popular", "Popular")}:
          </p>
          <div class="flex gap-2 badges flex-wrap justify-center">
            {sidebar.map((item: any) => {
              const href = getFirstHref(item);
              return (
                <a class="badge no-underline" href={href}>
                  {item.label}
                </a>
              );
            })}
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  @layer starlight.core {
    h1 {
      font-size: clamp(2.25rem, 1.6rem + 3vw, 3.25rem);
      line-height: 1.08;
      letter-spacing: -0.025em;
      font-weight: 600;
      font-family: var(--font-primary);
      color: var(--sl-color-white);
    }

    .tagline {
      max-width: 36rem;
      margin-top: 1rem;
      margin-inline: auto;
      font-size: 1.1875rem;
      line-height: 1.5;
      color: color-mix(in srgb, var(--sl-color-white) 60%, transparent);
    }

    .search-container {
      width: 90%;
      margin: auto;
      background: var(--sl-color-black);
      border: 1px solid var(--sl-color-hairline);
      border-radius: 14px;
      box-shadow: none;
    }

    .popular-label {
      font-size: 0.8125rem;
      letter-spacing: 0.02em;
      color: color-mix(in srgb, var(--sl-color-white) 55%, transparent);
    }

    .badges {
      background: transparent;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      background: transparent;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 9999px;
      padding: 0.35rem 0.85rem;
      font-size: 0.8125rem;
      color: color-mix(in srgb, var(--sl-color-white) 55%, transparent);
      transition:
        border-color 0.15s ease,
        color 0.15s ease;
    }
    .badge:hover {
      border-color: color-mix(in srgb, var(--sl-color-accent) 50%, transparent);
      color: var(--sl-color-white);
    }

    @media (max-width: 940px) {
      h1 {
        font-size: 2.25rem;
        line-height: 1.1;
        letter-spacing: -0.02em;
      }
      .search-container {
        width: 100%;
      }
    }
  }
</style>
<script>
  const iconElements = document.querySelector("[data-icon-path]");
  const heroSection = document.querySelector(".hero");
  const header = document.querySelector(".header");
  const heroBG = document.querySelector(".hero-bg") as HTMLElement;

  const totalHeight =
    (heroSection?.clientHeight || 0) + (header?.clientHeight || 0) + 24;

  heroBG.style.height = `${totalHeight}px`;

  // make image element and add the path to src
  if (iconElements) {
    const iconPath = iconElements.getAttribute("data-icon-path");

    const img = document.createElement("img");
    img.src = `/${iconPath}` || "";
    img.alt = "icon";
    img.className =
      "hidden lg:inline-block size-20 -mb-2 rounded-2xl animate-[bounce_2s_ease-in-out_infinite]";
    iconElements.replaceWith(img);
  }
</script>
