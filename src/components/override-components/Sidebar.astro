---
import MobileMenuFooter from "@astrojs/starlight/components/MobileMenuFooter.astro";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import { Icon } from "@astrojs/starlight/components";
import SidebarSublist from "./SidebarSublist.astro";

// Each course is an isolated section: show only the sidebar group that contains
// the current page, so courses never bleed into one another. A backlink returns
// to the full course catalog.
const fullSidebar = Astro.locals.starlightRoute.sidebar;

function hasCurrent(item: any): boolean {
  if (item?.type === "link") return Boolean(item.isCurrent);
  if (Array.isArray(item?.entries)) return item.entries.some(hasCurrent);
  return false;
}

const activeGroup = fullSidebar.find(hasCurrent);
const sidebar = activeGroup ? [activeGroup] : fullSidebar;
---

<SidebarPersister>
  <button class="sidebar-ai-btn" type="button" data-sidebar-ai-toggle>
    <span class="sidebar-ai-btn__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" width="15" height="15">
        <path d="M12 3l1.85 5.1L19 10l-5.15 1.9L12 17l-1.85-5.1L5 10l5.15-1.9L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        <path d="M19 15l.75 2.25L22 18l-2.25.75L19 21l-.75-2.25L16 18l2.25-.75L19 15Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="sidebar-ai-btn__copy">
      <strong>Ask AI</strong>
      <small>Search these notes</small>
    </span>
  </button>

  <a class="catalog-backlink" href="/content/">
    <Icon name="left-arrow" size="1rem" />
    <span>All content</span>
  </a>
  <SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<script>
  // Use guarded event delegation so it works across view transitions without stacking handlers.
  const globalWindow = window as typeof window & { __slopnotesSidebarAIListener?: boolean };
  if (!globalWindow.__slopnotesSidebarAIListener) {
    globalWindow.__slopnotesSidebarAIListener = true;
    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement)?.closest?.("[data-sidebar-ai-toggle]");
      if (!btn) return;
      // @ts-ignore
      window.slopnotesAI?.toggle?.();
    });
  }
</script>

<style>
  .sidebar-ai-btn {
    display: flex;
    align-items: center;
    gap: 0.62rem;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0 0 0.95rem;
    padding: 0.58rem 0.62rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-white) 9%, transparent);
    border-radius: 0.85rem;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--sl-color-white) 5%, transparent), transparent),
      color-mix(in srgb, var(--sl-color-white) 3%, transparent);
    color: color-mix(in srgb, var(--sl-color-white) 72%, transparent);
    cursor: pointer;
    text-align: left;
    transition: color 180ms ease, background 180ms ease, border-color 180ms ease, transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .sidebar-ai-btn:hover {
      color: var(--sl-color-white);
      border-color: color-mix(in srgb, var(--sl-color-accent) 28%, transparent);
      background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
    }
  }
  .sidebar-ai-btn:active { transform: scale(0.98); }
  .sidebar-ai-btn:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    outline-offset: 3px;
  }
  .sidebar-ai-btn__icon {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    flex: 0 0 auto;
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
    color: color-mix(in srgb, var(--sl-color-accent) 76%, var(--sl-color-white));
  }
  .sidebar-ai-btn__copy {
    display: grid;
    min-width: 0;
    gap: 0.08rem;
  }
  .sidebar-ai-btn__copy strong {
    font-size: 0.8rem;
    font-weight: 650;
    line-height: 1.1;
  }
  .sidebar-ai-btn__copy small {
    color: color-mix(in srgb, var(--sl-color-white) 42%, transparent);
    font-size: 0.68rem;
    font-weight: 450;
    line-height: 1.15;
  }
  .sidebar-ai-btn svg { pointer-events: none; }

  .catalog-backlink {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 100%;
    margin-bottom: 1.25rem;
    font-size: 0.8125rem;
    text-decoration: none;
    color: color-mix(in srgb, var(--sl-color-white) 74%, transparent);
    transition: color 0.15s ease;
  }
  .catalog-backlink span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .catalog-backlink:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .catalog-backlink:hover {
      color: var(--sl-color-accent);
    }
  }
  /* 44px-ish target on coarse pointers; desktop keeps tight rhythm. */
  @media (pointer: coarse) {
    .catalog-backlink {
      min-height: 44px;
    }
    .sidebar-ai-btn {
      min-height: 44px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sidebar-ai-btn {
      transition: color 150ms ease, background 150ms ease, border-color 150ms ease;
    }
    .sidebar-ai-btn:active {
      transform: none;
    }
  }
</style>
