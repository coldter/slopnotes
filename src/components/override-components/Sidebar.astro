---
import MobileMenuFooter from "@astrojs/starlight/components/MobileMenuFooter.astro";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import { Icon } from "@astrojs/starlight/components";
import { flattenSidebar } from "node_modules/@astrojs/starlight/utils/navigation";
import SidebarSublist from "./SidebarSublist.astro";

// One course at a time: only the top-level group that owns the current page is
// rendered, so courses never bleed into one another; the backlink returns to
// the full catalog. Pages that are not listed in sidebar.json (e.g.
// kotlin-backend/01-dev-environment/json-cli) have no `isCurrent` link, so the
// guide whose deepest href prefixes the path owns them.
const { sidebar: fullSidebar } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;

function containsCurrent(entries: any[]): boolean {
  return (flattenSidebar(entries) as any[]).some((page) => page?.isCurrent);
}

function longestHrefPrefix(entries: any[]): number {
  let longest = -1;
  for (const page of flattenSidebar(entries) as any[]) {
    const href = page?.href;
    if (typeof href !== "string" || !href) continue;
    if (pathname.startsWith(href)) longest = Math.max(longest, href.length);
  }
  return longest;
}

const groups = fullSidebar.filter((entry: any) => entry.type === "group");
const activeGroup =
  groups.find((entry: any) => containsCurrent(entry.entries)) ??
  groups
    .map((entry: any) => ({ entry, length: longestHrefPrefix(entry.entries) }))
    .filter(({ length }) => length > 0)
    .sort((a, b) => b.length - a.length)[0]?.entry;

const sidebar = activeGroup ? [activeGroup] : fullSidebar;

// Starlight persists the rail's open groups and scroll by index, keyed by the
// hash of the sidebar that was rendered. `SidebarPersister` hashes
// `starlightRoute.sidebar`, so handing it the scoped list makes the key
// course-specific: state saved while reading one course can no longer be
// replayed by index onto another course's tree (which used to collapse the
// group holding the current page).
Astro.locals.starlightRoute.sidebar = sidebar;
---

<SidebarPersister>
  <a class="catalog-backlink" href="/content/">
    <Icon name="left-arrow" size="1rem" />
    <span>All content</span>
  </a>
  <SidebarSublist sublist={sidebar} />
</SidebarPersister>

<script is:inline>
  // Group open-state persists across pages, so a collapsed section could hide
  // the page you just navigated to. Re-open the chain that owns this page
  // (marked server-side) after Starlight's restore has run.
  (() => {
    const openCurrentChain = () => {
      document
        .querySelectorAll(".sidebar-content details[data-open-current]")
        .forEach((details) => {
          if (!details.open) details.open = true;
        });
    };
    openCurrentChain();
    document.addEventListener("astro:page-load", openCurrentChain);
  })();
</script>

<div class="lg:hidden">
  <MobileMenuFooter />
</div>

<style>
  @layer starlight.core {
    .catalog-backlink {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      max-width: 100%;
      margin-bottom: 0.75rem;
      font-size: 0.8125rem;
      font-weight: 500;
      text-decoration: none;
      color: var(--muted-foreground);
      transition: color 0.15s ease;
    }
    .catalog-backlink span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .catalog-backlink:focus-visible {
      outline: 2px solid var(--ring);
      outline-offset: 2px;
    }
    @media (hover: hover) and (pointer: fine) {
      .catalog-backlink:hover {
        color: var(--foreground);
      }
    }
    /* 44px-ish target on coarse pointers; desktop keeps the tight rhythm. */
    @media (pointer: coarse) {
      .catalog-backlink {
        min-height: 44px;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .catalog-backlink {
        transition: none;
      }
    }
  }
</style>
