---
import MobileMenuToggle from "./MobileMenuToggle.astro";
import Footer from "./Footer.astro";
import SlopnotesAI from "../SlopnotesAI.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
  {!hasSidebar ? <div class="hero-bg" /> : <div class="doc-bg" />}
  <header class={"header" + (hasSidebar ? " has-sidebar" : " no-sidebar")}>
    <slot name="header" />
  </header>
  <div class="main-frame">
    <div class="container flex relative">
      {
        hasSidebar && (
          <nav
            class="sidebar print:hidden"
            aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
          >
            <MobileMenuToggle />

            <div id="starlight__sidebar" class="sidebar-pane">
              <div class="sidebar-content sl-flex">
                <slot name="sidebar" />
              </div>
            </div>
            <div class="sidebar-scrim" aria-hidden="true" data-sidebar-scrim></div>
          </nav>
        )
      }
      <slot />
    </div>
  </div>
  {!hasSidebar && <Footer />}
  <SlopnotesAI />
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }
    .header {
      z-index: var(--sl-z-index-navbar);
      /* position: fixed; */
      position: sticky;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      /* height: 4.5rem; */
      /* Transparent at top so the hero glow reads clean; the hairline
         arrives only when .navbar-scrolled lands (navigation.css). */
      border-bottom: 1px solid transparent;
      padding: var(--sl-nav-pad-y) 0px;
      transition: background-color 200ms ease-out, border-color 200ms ease-out;
      /* padding-inline-end: var(--sl-nav-pad-x); */
    }
    .sidebar {
      opacity: 0;
      transform: none;
      transition: opacity 220ms ease-out, transform 220ms ease-out;
    }
    .sidebar.is-ready {
      opacity: 1;
    }
    .sidebar button:where(.astro-jif73yzw) {
      top: 14px !important;
    }
    footer {
      display: none;
    }
    @media (max-width: 800px) {
      .header {
        background-color: var(--sl-color-black);
        padding: 6px var(--sl-nav-pad-x);
      }
    }

    :global([data-has-sidebar]) .main-frame {
      padding-top: 2rem;
    }
    @media (max-width: 71.99rem) {
      /* Clear the fixed mobile TOC bar; derived from its height token so the
         two can never drift (0 when there is no TOC / at ≥72rem). */
      :global([data-has-sidebar]) .main-frame {
        padding-top: calc(var(--sl-mobile-toc-height) + 1rem);
      }
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: sticky;
      height: 80vh;
      z-index: var(--sl-z-index-menu);
      scrollbar-width: none;
      background-color: var(--sl-color-black);
      overflow-y: auto;
      inset-inline-start: 0;
      width: 100%;
      padding-bottom: 2rem;
      transition:
        opacity 220ms ease-out,
        transform 220ms ease-out,
        visibility 220ms;
    }
    @media (max-width: 1024px) {
      .sidebar-pane {
        inset-block: var(--sl-nav-height) 0;
      }
    }
    @media (max-width: 799px) {
      .sidebar-pane {
        position: fixed;
        /* Pinned below the sticky header; one-handed width that never
           swallows small phones. */
        inset-block: var(--sl-nav-height) 0;
        inset-inline-start: 0;
        width: min(85vw, var(--sl-sidebar-width));
        height: auto;
        padding: 1rem 1.25rem 3rem;
        padding-inline-start: max(1.25rem, env(safe-area-inset-left));
        border-inline-end: 1px solid var(--sl-color-hairline);
        opacity: 0;
        transform: translateX(-12px);
      }
      :global([dir="rtl"]) .sidebar-pane {
        transform: translateX(12px);
      }
      /* Dimming scrim: modal focus for the drawer, tap-to-close. */
      .sidebar-scrim {
        position: fixed;
        inset: var(--sl-nav-height) 0 0 0;
        z-index: var(--sl-z-index-toc);
        background: rgba(0, 0, 0, 0.5);
        opacity: 0;
        visibility: hidden;
        transition: opacity 220ms ease-out, visibility 220ms;
      }
      :global([aria-expanded="true"]) ~ .sidebar-scrim {
        opacity: 1;
        visibility: visible;
      }
    }

    :global([aria-expanded="true"]) ~ .sidebar-pane {
      --sl-sidebar-visibility: visible;
      opacity: 1;
      transform: none;
    }
    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
      padding-top: 0px;
      padding-left: 0px;
      content: "";
      padding-bottom: 1px;
    }

    @media (min-width: 50rem) {
      .sidebar-pane {
        --sl-sidebar-visibility: visible;
        width: var(--sl-sidebar-width);
        background-color: transparent;
        inset-block: calc(var(--sl-nav-height) + 1.5rem) 0;
      }
    }

    /* `md:sl-hidden` on the menu button fires at Tailwind's md (768px) while
       the drawer only docks at 50rem (800px) — re-show the button inside the
       768–800px gap so navigation is never stranded. `!important` in this
       earlier layer beats the non-important later utilities layer. */
    @media (min-width: 48rem) and (max-width: 49.99rem) {
      .sidebar :global(starlight-menu-button button) {
        display: flex !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .header {
        transition: none;
      }
      .sidebar,
      .sidebar-pane {
        transition: opacity 150ms ease;
        transform: none;
      }
    }
  }
</style>

<script>
  const sidebar = document.querySelector(".sidebar") as HTMLElement;

  // Initialize sidebar functionality
  function initializeSidebar(): void {
    if (sidebar) {
      sidebar.classList.add("is-ready");
    }
  }

  // Initialize sidebar when DOM is ready (only once)
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeSidebar);
  } else {
    initializeSidebar();
  }

  // Tap-to-close on the drawer scrim (guarded for view transitions).
  const globalWindow = window as typeof window & { __slopnotesScrimListener?: boolean };
  if (!globalWindow.__slopnotesScrimListener) {
    globalWindow.__slopnotesScrimListener = true;
    document.addEventListener("click", (e) => {
      const scrim = (e.target as HTMLElement)?.closest?.("[data-sidebar-scrim]");
      if (!scrim) return;
      const btn = document.querySelector(
        'starlight-menu-button button[aria-expanded="true"]'
      ) as HTMLButtonElement | null;
      btn?.click();
    });
  }

  // accordion
  const accordions = document.querySelectorAll(
    ".accordion"
  ) as NodeListOf<HTMLElement>;

  accordions.forEach((accordion) => {
    // close other accordions when one is opened
    accordion.addEventListener("click", () => {
      accordions.forEach((otherAccordion) => {
        if (otherAccordion !== accordion) {
          otherAccordion.classList.remove("active");
        }
      });
      accordion.classList.toggle("active");
    });
  });
</script>
