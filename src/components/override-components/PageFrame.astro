---
import Footer from "./Footer.astro";
import SlopnotesAI from "../SlopnotesAI.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
  <header class={"header" + (hasSidebar ? " has-sidebar" : " no-sidebar")}>
    <slot name="header" />
  </header>
  <div class="main-frame">
    <div class="container flex relative">
      {
        hasSidebar && (
          <nav
            class="sidebar print:hidden"
            aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
          >
            <div id="starlight__sidebar" class="sidebar-pane">
              <div class="sidebar-content sl-flex">
                <slot name="sidebar" />
              </div>
            </div>
            <div class="sidebar-scrim" aria-hidden="true" data-sidebar-scrim />
          </nav>
        )
      }
      <slot />
    </div>
  </div>
  {!hasSidebar && <Footer />}
  <SlopnotesAI />
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }
    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline: 0;
      inset-block-start: 0;
      height: var(--sl-nav-height);
      /* Flex row so the inner stretches to the bar's content box (`height: 100%`
         does not resolve against a fixed box). Flat header (Black theme): solid
         surface, no hairline. The reference's 4rem bar pads 0.75rem on three
         sides and 1.5rem on the inline start. */
      display: flex;
      padding: 0.75rem 0.75rem 0.75rem 1.5rem;
      background-color: var(--background);
      border-bottom: none;
    }
    footer {
      display: none;
    }

    /* The rail is always laid out: below 64rem the drawer is `position: fixed`,
       so the nav itself has no in-flow content and takes no grid space. */
    .sidebar {
      display: flex;
    }

    .sidebar-pane {
      display: flex;
      flex-direction: column;
      position: sticky;
      top: calc(var(--sl-nav-height) + 0.6rem);
      height: calc(100svh - 10rem);
      width: var(--sl-sidebar-width);
      background: transparent;
      border: 0;
      padding: 0;
      overflow: hidden;
      z-index: var(--sl-z-index-menu);
    }
    /* Hairline where the rail meets the article (reference gradient, fading at
       both ends); docked widths only, never in the drawer. */
    .sidebar-pane::after {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      display: none;
      z-index: 1;
      width: 1px;
      background: linear-gradient(
        to bottom,
        transparent 0%,
        var(--border) 50%,
        transparent 100%
      );
    }
    @media (min-width: 1024px) {
      .sidebar-pane::after {
        display: flex;
      }
    }

    .sidebar-content {
      /* 16rem text column inside the 18.75rem gutter: the reference's 14rem
         wraps our longer guide titles twice at the bumped label size. */
      width: 16rem;
      padding-inline-start: 0.625rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      min-height: 0;
      overflow-y: auto;
      overflow-x: hidden;
      scrollbar-width: none;
      --_scroll-fade-size-t: var(
        --scroll-fade-t-size,
        var(--scroll-fade-size, min(12%, 2.5rem))
      );
      --_scroll-fade-size-b: var(
        --scroll-fade-b-size,
        var(--scroll-fade-size, min(12%, 2.5rem))
      );
      --scroll-fade-block: linear-gradient(
        to bottom,
        transparent 0,
        #000 var(--scroll-fade-t, 0px),
        #000 calc(100% - var(--scroll-fade-b, 0px)),
        transparent 100%
      );
      -webkit-mask-image: var(--scroll-fade-block);
      mask-image: var(--scroll-fade-block);
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }
    @supports (animation-timeline: scroll()) {
      .sidebar-content {
        animation:
          1ms ease-in-out scroll-fade-reveal-t,
          1ms ease-in-out scroll-fade-reveal-b;
        animation-timeline: scroll(self y), scroll(self y);
        animation-range:
          0 var(--scroll-fade-reveal, 2.5rem),
          calc(100% - var(--scroll-fade-reveal, 2.5rem)) 100%;
        animation-fill-mode: both;
      }
    }
    @keyframes scroll-fade-reveal-t {
      0% {
        --scroll-fade-t: 0px;
      }
      100% {
        --scroll-fade-t: var(
          --_scroll-fade-size-t,
          var(--scroll-fade-size, min(12%, 2.5rem))
        );
      }
    }
    @keyframes scroll-fade-reveal-b {
      0% {
        --scroll-fade-b: var(
          --_scroll-fade-size-b,
          var(--scroll-fade-size, min(12%, 2.5rem))
        );
      }
      100% {
        --scroll-fade-b: 0px;
      }
    }

    /* Below 64rem the rail becomes a drawer over the page. */
    @media (max-width: 63.99rem) {
      .sidebar-pane {
        --sl-sidebar-visibility: hidden;
        position: fixed;
        inset-block: var(--sl-nav-height) 0;
        inset-inline-start: 0;
        width: min(85vw, var(--sl-sidebar-width));
        height: auto;
        padding: 1rem 0 3rem;
        background: var(--background);
        visibility: var(--sl-sidebar-visibility);
        opacity: 0;
        transform: translateX(-12px);
        transition:
          opacity 220ms ease-out,
          transform 220ms ease-out,
          visibility 220ms;
      }
      :global([dir="rtl"]) .sidebar-pane {
        transform: translateX(12px);
      }
      :global([data-mobile-menu-expanded]) .sidebar-pane {
        --sl-sidebar-visibility: visible;
        opacity: 1;
        transform: none;
      }
      /* Dimming scrim: modal focus for the drawer, tap-to-close. */
      .sidebar-scrim {
        position: fixed;
        inset: var(--sl-nav-height) 0 0 0;
        z-index: var(--sl-z-index-toc);
        background: rgba(0, 0, 0, 0.5);
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 220ms ease-out,
          visibility 220ms;
      }
      :global([data-mobile-menu-expanded]) .sidebar-scrim {
        opacity: 1;
        visibility: visible;
      }
      /* The bar and the scrim share `--sl-z-index-toc`, and the bar paints
         above it: while the drawer is open, tapping the bar would open the TOC
         over the drawer. */
      :global([data-mobile-menu-expanded]) :global(.mobile-toc-wrap) {
        visibility: hidden;
      }
      /* Keep the drawer's own gutter clear of the notch/home indicator, and let
         the column fill the drawer: the docked rail's 16rem measure would wrap
         every guide title early and leave a dead strip on the right. */
      :global(.sidebar-content) {
        width: 100%;
        padding-inline: max(1rem, env(safe-area-inset-left))
          max(1rem, env(safe-area-inset-right));
        /* Rows are full-width targets in the drawer; the column clips the
           overflow (`overflow-x: hidden`), so a viewport-wide hit area is
           safe. */
        --sidebar-row-hit: 100vw;
      }
      /* A modal drawer owns the screen: the floating AI trigger sits outside
         Starlight's z-index scale (`z-30`) and would paint above the scrim. */
      :global([data-mobile-menu-expanded]) :global([data-ai-open]) {
        visibility: hidden;
      }
    }

    /* The header is fixed: the frame clears it, plus the fixed mobile TOC bar
       below the 80rem TOC handoff (0 when there is no TOC / at >=80rem). */
    .main-frame {
      padding-top: var(--sl-nav-height);
    }
    @media (max-width: 79.99rem) {
      .main-frame {
        padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .sidebar-pane,
      .sidebar-scrim {
        transition: none;
        transform: none;
      }
    }
  }
</style>

<script>
  // Tap-to-close on the drawer scrim (guarded for view transitions).
  const globalWindow = window as typeof window & {
    __slopnotesScrimListener?: boolean;
  };
  if (!globalWindow.__slopnotesScrimListener) {
    globalWindow.__slopnotesScrimListener = true;
    document.addEventListener("click", (e) => {
      const scrim = (e.target as HTMLElement)?.closest?.("[data-sidebar-scrim]");
      if (!scrim) return;
      // `aria-expanded` lives on the custom element (MobileMenuToggle).
      const btn = document.querySelector(
        'starlight-menu-button[aria-expanded="true"] button',
      ) as HTMLButtonElement | null;
      btn?.click();
    });
  }
</script>
