---
import MobileTableOfContents from "./MobileTableOfContents.astro";
import TableOfContents from "./TableOfContents.astro";
---

{
  Astro.locals.starlightRoute.toc && (
    <>
      <div class="mobile-toc-wrap">
        <MobileTableOfContents />
      </div>
      <div class="right-sidebar-panel">
        <div class="sl-container">
          <TableOfContents />
        </div>
      </div>
    </>
  )
}

<style>
  @layer starlight.core {
    /* Mobile/desktop TOC handoff happens exactly at 72rem (1152px), matching
       the content grid in TwoColumnContent. Tailwind's `lg` (1024px) would
       leave a 128px zone with no fixed bar AND a stacked desktop panel. */
    .mobile-toc-wrap {
      display: block;
      min-width: 0;
    }
    .right-sidebar-panel {
      display: none;
    }
    @media (min-width: 72rem) {
      .mobile-toc-wrap {
        display: none;
      }
      .right-sidebar-panel {
        display: block;
      }
    }
    .sl-container {
      width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
    }
    .right-sidebar-panel :global(h2) {
      color: color-mix(in srgb, var(--sl-color-white) 78%, transparent);
      font-size: 0.8125rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
      margin-bottom: 0.5rem;
    }
    .right-sidebar-panel :global(:where(a)) {
      display: block;
      font-size: var(--sl-text-xs);
      text-decoration: none;
      color: color-mix(in srgb, var(--sl-color-white) 78%, transparent);
      overflow-wrap: anywhere;
    }
    @media (hover: hover) and (pointer: fine) {
      .right-sidebar-panel :global(:where(a):hover) {
        color: var(--sl-color-white);
      }
    }
    .right-sidebar-panel :global(a:focus-visible) {
      outline: 2px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
      outline-offset: 3px;
    }
    .right-sidebar-panel :global(a[aria-current="true"]) {
      color: var(--sl-color-white);
      font-weight: 600;
      /* Neutral wash only — no accent bars/washes (deliberate). */
      background-color: color-mix(in srgb, var(--sl-color-white) 6%, transparent);
      border-radius: 0.375rem;
    }
    @media (min-width: 72rem) {
      .sl-container {
        /* 0.25-remainder formula cramps to ~192px at 1152px viewports, so
           floor at 12rem and cap at 16rem; the `1fr auto` grid absorbs it. */
        width: clamp(
          12rem,
          (
            (
                100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) -
                  2 * var(--sl-sidebar-pad-x)
              ) * 0.25
          ),
          16rem
        );
        max-width: 100%;
      }
    }
  }
</style>
