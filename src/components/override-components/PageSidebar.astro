---
import MobileTableOfContents from "./MobileTableOfContents.astro";
import TableOfContents from "./TableOfContents.astro";
---

{
  Astro.locals.starlightRoute.toc && (
    <>
      <div class="mobile-toc-wrap">
        <MobileTableOfContents />
      </div>
      <div class="right-sidebar-panel">
        <div class="sl-container">
          <TableOfContents />
        </div>
      </div>
    </>
  )
}

<style>
  @layer starlight.core {
    /* Mobile/desktop TOC handoff happens exactly at 80rem (1280px), matching
       the reference theme and the content grid in TwoColumnContent: below it
       the fixed bar is the TOC, from it the docked rail is. */
    .mobile-toc-wrap {
      display: block;
      min-width: 0;
    }
    .right-sidebar-panel {
      display: none;
    }
    @media (min-width: 80rem) {
      .mobile-toc-wrap {
        display: none;
      }
      .right-sidebar-panel {
        display: block;
      }
    }
    /* Reference rail geometry: the 18rem gutter (TwoColumnContent) minus its
       2rem inline padding, plus the panel's 0.5rem, so the labels land 2.5rem
       inside the gutter exactly where the reference's do. */
    /* Label block: 14rem starting 2.5rem inside the 18rem gutter (the
       container owns the inset) — the reference's 225px label box. */
    .right-sidebar-panel {
      padding: 0 0 calc(var(--spacing) * 4);
    }
    .sl-container {
      width: 14rem;
      max-width: 100%;
      padding-inline: 0;
    }
  }
</style>
