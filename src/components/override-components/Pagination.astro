---
import { plainLabel } from "@/lib/utils/textConverter";
import { Icon } from "@astrojs/starlight/components";

const { dir, pagination, id } = Astro.locals.starlightRoute;
const isRtl = dir === "rtl";

// Keep prev/next within the current course. Starlight computes pagination from
// the full sidebar, which would otherwise link from the end of one course into
// the start of another — courses are meant to be self-contained here.
const course = String(id).replace(/^\/+/, "").split("/")[0];
const sameCourse = (link: any) =>
  Boolean(link?.href) &&
  link.href.replace(/^\/+/, "").split("/")[0] === course;

const prev = sameCourse(pagination.prev) ? pagination.prev : undefined;
const next = sameCourse(pagination.next) ? pagination.next : undefined;
---

<div class="pagination-links print:hidden" dir={dir}>
  {
    prev && (
      <a href={prev.href} rel="prev">
        <Icon name={isRtl ? "right-caret" : "left-caret"} size="1rem" />
        <span>
          <span class="link-head"> {Astro.locals.t("page.previousLink")}</span>
          <br />
          <span class="link-title">{plainLabel(prev.label)}</span>
        </span>
      </a>
    )
  }
  {
    next && (
      <a href={next.href} rel="next">
        <Icon name={isRtl ? "left-caret" : "right-caret"} size="1rem" />
        <span>
          <span class="link-head">{Astro.locals.t("page.nextLink")}</span>
          <br />
          <span class="link-title">{plainLabel(next.label)}</span>
        </span>
      </a>
    )
  }
</div>

<style>
  @layer starlight.core {
    .pagination-links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
      gap: 1rem;
    }

    a {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 0.75rem;
      width: 100%;
      flex-basis: calc(50% - 0.5rem);
      flex-grow: 1;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 10px;
      padding: 0.875rem 1rem;
      text-decoration: none;
      color: color-mix(in srgb, var(--sl-color-white) 78%, transparent);
      overflow-wrap: anywhere;
      transition: border-color 0.2s ease;
    }
    [rel="next"] {
      justify-content: end;
      text-align: end;
      flex-direction: row-reverse;
    }
    a:hover {
      border-color: var(--sl-color-accent);
    }
    .link-head {
      font-size: 0.75rem;
      color: color-mix(in srgb, var(--sl-color-white) 78%, transparent);
      margin-bottom: 0.125rem;
    }

    .link-title {
      color: var(--sl-color-white);
      font-size: 0.9375rem;
      font-weight: 500;
      line-height: var(--sl-line-height-headings);
    }

    svg {
      flex-shrink: 0;
      color: color-mix(in srgb, var(--sl-color-white) 78%, transparent);
      transition: color 0.2s ease;
    }
    a:hover svg {
      color: var(--sl-color-accent);
    }
  }
</style>
