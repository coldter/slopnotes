---
import { Icon } from "@astrojs/starlight/components";
import { plainLabel } from "@/lib/utils/textConverter";
import { inGuidePagination } from "@/lib/utils/pagination";

const { dir, pagination, id } = Astro.locals.starlightRoute;
const isRtl = dir === "rtl";

const { prev, next } = inGuidePagination(pagination, String(id));
---

<div class="pagination-links print:hidden" dir={dir}>
  {
    prev && (
      <a href={prev.href} rel="prev">
        <Icon name={isRtl ? "right-arrow" : "left-arrow"} />
        <span>{plainLabel(prev.label)}</span>
      </a>
    )
  }
  {
    next && (
      <a class="next" href={next.href} rel="next">
        <span>{plainLabel(next.label)}</span>
        <Icon name={isRtl ? "left-arrow" : "right-arrow"} />
      </a>
    )
  }
</div>

<style>
  @layer starlight.core {
    .pagination-links {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      padding-top: 1rem;
      margin-top: 2rem;
    }

    a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
      height: 2rem;
      padding: 0 0.75rem;
      border-radius: calc(var(--radius) - 2px);
      background-color: var(--secondary);
      color: var(--secondary-foreground);
      font-size: 0.875rem;
      font-weight: 500;
      line-height: 1.25rem;
      text-decoration: none;
      max-width: min(100%, 18rem);
      transition: background-color 0.15s;
    }

    /* The next pill sits at the far edge of the row. */
    .next {
      margin-left: auto;
    }

    /* Long titles ellipsis instead of widening the pill. */
    a span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    a:focus-visible {
      outline: 2px solid var(--ring);
      outline-offset: 2px;
    }
    @media (hover: hover) and (pointer: fine) {
      a:hover {
        background-color: color-mix(in srgb, var(--secondary) 80%, transparent);
      }
    }
    @media (pointer: coarse) {
      a {
        height: auto;
        min-height: 44px;
        padding: 0 1rem;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      a {
        transition: none;
      }
    }

    svg {
      flex-shrink: 0;
      width: 1rem;
      height: 1rem;
    }
  }
</style>
