---
import Breadcrumb from "../Breadcrumb.astro";
---

<div class="content-container">
  <div class="main-pane">
    {
      Astro.locals.starlightRoute.hasSidebar && (
        <div class="breadcrumb-container">
          <Breadcrumb />
        </div>
      )
    }

    {
      Astro.locals.starlightRoute.hasSidebar && (
        <div class="ask-page-bar">
          <button type="button" class="ask-page-btn" data-ask-page-btn>
            <span aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" width="15" height="15">
                <path d="M12 3l1.85 5.1L19 10l-5.15 1.9L12 17l-1.85-5.1L5 10l5.15-1.9L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
            </span>
            <strong>Ask about this page</strong>
          </button>
        </div>
      )
    }

    <slot />
  </div>
  {
    Astro.locals.starlightRoute.toc && (
      <aside class="right-sidebar-container print:hidden">
        <div class="right-sidebar">
          <slot name="right-sidebar" />
        </div>
      </aside>
    )
  }
</div>

<style>
  @layer starlight.core {
    .content-container {
      width: 100%;
      overflow: hidden;
      opacity: 0;
      transition: opacity 0.3s ease-in-out;
    }

    .main-pane {
      width: 100%;
    }
    :global([data-has-sidebar][data-has-toc]) .main-pane {
      overflow: hidden;
    }

    @media (min-width: 72rem) {
      :global([data-has-sidebar][data-has-toc]) .content-container {
        display: grid;
        grid-template-columns: 1fr auto;
        overflow: visible;
      }
      .right-sidebar-container {
        order: 2;
        position: relative;
      }

      .right-sidebar {
        position: sticky;
        inset-block: calc(var(--sl-nav-height) + 110px) 0;
        width: 100%;
        height: 80vh;
        overflow-y: auto;
        scrollbar-width: none;
      }

      :global([data-has-sidebar][data-has-toc]) .main-pane {
        --sl-content-margin-inline: auto 0;

        order: 1;
        overflow: hidden;
        border-left: 1px solid var(--sl-color-hairline);
        border-right: 1px solid var(--sl-color-hairline);
      }
    }
  }

  .ask-page-bar {
    padding: 0.35rem var(--sl-content-pad-x, 1rem) 0;
  }

  .ask-page-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: -0.35rem;
    padding: 0.34rem 0.66rem 0.34rem 0.38rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-white) 9%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-white) 3%, transparent);
    color: color-mix(in srgb, var(--sl-color-white) 68%, transparent);
    cursor: pointer;
    transition: color 190ms ease, background 190ms ease, border-color 190ms ease, transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ask-page-btn span {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-accent) 11%, transparent);
    color: color-mix(in srgb, var(--sl-color-accent) 78%, var(--sl-color-white));
  }
  .ask-page-btn strong {
    font-size: 0.76rem;
    font-weight: 620;
    line-height: 1;
  }
  .ask-page-btn svg { pointer-events: none; }
  .ask-page-btn:hover {
    color: var(--sl-color-white);
    border-color: color-mix(in srgb, var(--sl-color-accent) 28%, transparent);
    background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
  }
  .ask-page-btn:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    outline-offset: 3px;
  }
  .ask-page-btn:active { transform: scale(0.97); }
</style>

<script>
  const contentContainer = document.querySelector(
    ".content-container"
  ) as HTMLElement;

  if (contentContainer) {
    contentContainer.style.opacity = "1";
  }

  // Use guarded event delegation so the button works after Astro view transitions without stacking handlers.
  const globalWindow = window as typeof window & { __slopnotesAskPageListener?: boolean };
  if (!globalWindow.__slopnotesAskPageListener) {
    globalWindow.__slopnotesAskPageListener = true;
    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement)?.closest?.("[data-ask-page-btn]");
      if (!btn) return;
      e.preventDefault();
      // @ts-ignore
      window.slopnotesAI?.toggle?.({
        includeCurrentPage: true,
        value: "Summarize this page",
      });
    });
  }
</script>
