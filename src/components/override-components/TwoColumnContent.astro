---
---

<div class="content-container">
  <div class="main-pane">
    <slot />
  </div>
  {
    Astro.locals.starlightRoute.toc && (
      <aside class="right-sidebar-container print:hidden">
        <div class="right-sidebar">
          <slot name="right-sidebar" />
        </div>
      </aside>
    )
  }
</div>

<style>
  @layer starlight.core {
    .content-container {
      width: 100%;
      /* `clip` avoids horizontal blowout without trapping sticky descendants
         the way `hidden` (a scroll container) can. */
      overflow-x: clip;
      opacity: 0;
      transition: opacity 0.3s ease-in-out;
    }

    .main-pane {
      width: 100%;
      min-width: 0;
      /* Splash and 404 surfaces keep the page gutter the content panel used to
         carry; reading pages get it from the rules below. */
      padding-inline: var(--sl-content-pad-x);
    }
    /* Reading chrome: the pane owns the mobile gutter and the vertical rhythm
       (the header is fixed, so this is the space above the page title). */
    :global([data-has-sidebar]) .main-pane {
      padding-inline: calc(var(--spacing) * 4);
      padding-block: calc(var(--spacing) * 6);
    }
    @media (min-width: 48rem) {
      :global([data-has-sidebar]) .main-pane {
        padding-inline: 0;
      }
    }
    @media (min-width: 64rem) {
      :global([data-has-sidebar]) .main-pane {
        padding-block: calc(var(--spacing) * 8);
        padding-top: calc(var(--spacing) * 12);
      }
    }
    :global([data-has-sidebar][data-has-toc]) .main-pane {
      overflow: hidden;
    }
    /* Anchor jumps must clear the sticky header + fixed mobile TOC bar
       (browser scroll-padding covers `main` scrolling; this is the
       in-container backstop). Mobile TOC height is 0 at ≥80rem / without a
       TOC, so the token stays the single source of truth. */
    .main-pane :global(:is(h1, h2, h3, h4, h5, h6, [id])) {
      scroll-margin-top: calc(
        var(--sl-nav-height) + var(--sl-mobile-toc-height) + 1rem
      );
    }

    @media (min-width: 80rem) {
      /* Article and TOC gutter side by side: the gutter is flush right at 18rem
         (the reference's rail width) and the 40rem article is centred in the
         space that is left of it. */
      :global([data-has-sidebar][data-has-toc]) .content-container {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 18rem;
        column-gap: 0;
        overflow: visible;
      }
      .right-sidebar-container {
        order: 2;
        position: relative;
        width: 18rem;
        /* The reference's gutter is 2rem of container padding plus 0.5rem of
           panel padding; folding both into the inline-start padding keeps the
           label block (14rem, starting 2.5rem in) inside the container, so the
           18rem rail never overflows the viewport. */
        padding-inline: calc(var(--spacing) * 10) 0;
      }

      .right-sidebar {
        position: sticky;
        /* The reference is `top: 2rem` on a viewport-fixed rail whose
           Starlight padding-top is the nav height — contents land 2rem below
           the header. Ours is sticky, so the offset is explicit. */
        top: calc(var(--sl-nav-height) + var(--spacing) * 8);
        width: 100%;
        height: 90svh;
        border-inline-start: none;
        overflow-y: auto;
        scrollbar-width: none;
      }

      /* The pane owns the 40rem measure from the TOC handoff up, so the article
         is centred in the track rather than in the whole viewport. */
      :global([data-has-sidebar]) .main-pane {
        max-width: var(--sl-content-width);
        margin-inline: auto;
      }

      :global([data-has-sidebar][data-has-toc]) .main-pane {
        order: 1;
        overflow: hidden;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .content-container {
        transition: none;
      }
    }
  }
</style>

<script>
  const contentContainer = document.querySelector(
    ".content-container"
  ) as HTMLElement;

  if (contentContainer) {
    contentContainer.style.opacity = "1";
  }
</script>
