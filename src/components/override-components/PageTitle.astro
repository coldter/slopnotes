---
import { Icon } from "@astrojs/starlight/components";
import { inGuidePagination } from "@/lib/utils/pagination";

// Starlight's page-title id (`@astrojs/starlight/constants` is not an exported
// subpath); the table of contents links its top entry here.
const PAGE_TITLE_ID = "_top";

const { entry, pagination, id } = Astro.locals.starlightRoute;
const { title, description } = entry.data;
const { prev, next } = inGuidePagination(pagination, String(id));
---

<div class="page-title">
  <div class="page-title-header">
    <h1 id={PAGE_TITLE_ID}>{title}</h1>
    <div class="docs-nav">
      <div class="nav-buttons">
        {
          prev && (
            <a href={prev.href} rel="prev" aria-label="Previous page">
              <Icon name="left-arrow" />
            </a>
          )
        }
        {
          next && (
            <a href={next.href} rel="next" aria-label="Next page">
              <Icon name="right-arrow" />
            </a>
          )
        }
      </div>
    </div>
  </div>
  {description && <p class="page-description">{description}</p>}
</div>

<style>
  .page-title {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .page-title-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  @media (min-width: 768px) {
    .page-title-header {
      align-items: flex-start;
    }
  }

  .page-title-header h1 {
    margin: 0;
    color: var(--foreground);
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .docs-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .nav-buttons {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }

  .nav-buttons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: calc(var(--radius) * 0.8);
    color: var(--secondary-foreground);
    background: var(--secondary);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-buttons a:hover {
      background: var(--accent);
      color: var(--accent-foreground);
    }
  }
  .nav-buttons a:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  @media (pointer: coarse) {
    .nav-buttons a {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  .page-description {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.75rem;
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .page-description {
      max-width: 80%;
    }
  }

  @media (max-width: 640px) {
    .page-title-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .docs-nav {
      width: 100%;
      justify-content: flex-end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-buttons a {
      transition: none;
    }
  }
</style>
