---
import { Icon } from "@astrojs/starlight/components";
import SidebarRestorePoint from "./SidebarRestorePoint.astro";
import { flattenSidebar } from "node_modules/@astrojs/starlight/utils/navigation";
import { plainLabel } from "@/lib/utils/textConverter";

const { sublist, nested } = Astro.props;
const pathname = Astro.url.pathname;

// Longest sidebar href that prefixes the current path (`-1` when none does).
// Hrefs end with `/`, so `startsWith` is a safe path-segment test.
function longestHrefPrefix(entries: any[]): number {
  let longest = -1;
  for (const page of flattenSidebar(entries) as any[]) {
    const href = page?.href;
    if (typeof href !== "string" || !href) continue;
    if (pathname.startsWith(href)) longest = Math.max(longest, href.length);
  }
  return longest;
}

// sidebar.json lists chapter slugs only, so an unlisted child page (e.g.
// kotlin-backend/01-dev-environment/json-cli) has no link with `isCurrent`.
// The deepest href prefix in this sublist marks the owning group, so the whole
// ancestor chain (nested groups included) opens for such a page.
let bestPrefix = -1;
for (const entry of sublist as any[]) {
  if (entry.type !== "group") continue;
  bestPrefix = Math.max(bestPrefix, longestHrefPrefix(entry.entries));
}

function isOpenGroup(entry: any): boolean {
  if (flattenSidebar(entry.entries).some((i: any) => i.isCurrent)) return true;
  return bestPrefix > 0 && longestHrefPrefix(entry.entries) === bestPrefix;
}
---

<ul class:list={{ "top-level": !nested }}>
  {
    sublist.map((entry: any) => (
      <li>
        {entry.type === "link" ? (
          <a
            href={entry.href}
            aria-current={entry.isCurrent && "page"}
            {...entry.attrs}
          >
            <span class="row-hit-area" aria-hidden="true" />
            <span>{plainLabel(entry.label)}</span>
          </a>
        ) : (
          <details
            open={isOpenGroup(entry)}
            data-open-current={isOpenGroup(entry) ? "" : undefined}
          >
            <summary>
              <span class="group-label">{plainLabel(entry.label)}</span>
              <Icon name="right-caret" class="caret" size="1rem" />
            </summary>
            <SidebarRestorePoint />
            <Astro.self sublist={entry.entries} nested />
          </details>
        )}
      </li>
    ))
  }
</ul>

<style>
  @layer starlight.core {
    ul {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    /* Nested groups indent one step; links keep the tighter in-group rhythm. */
    ul:not(.top-level) {
      gap: 0.25rem;
      margin-top: 0.25rem;
      padding-inline-start: 0.75rem;
    }

    /* The rail's content starts just below the top: the catalog backlink owns
       the top slot, so the guide title follows it directly. */
    ul.top-level > li:first-child {
      padding-top: 0.5rem;
    }

    li {
      overflow-wrap: anywhere;
    }

    /* Our lists set their own `display`, which would otherwise beat the user
       agent's closed-`details` hiding: a collapsed group must actually hide
       its chapters (and its nested groups). */
    details:not([open]) > *:not(summary) {
      display: none;
    }

    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      /* 2rem single-line rows (1.25rem line box + 2x0.375rem padding); long
         group titles wrap and grow instead of spilling the box. */
      min-height: 2rem;
      padding: 0.375rem 0.5rem;
      line-height: 1.25rem;
      border-radius: calc(var(--radius) * 0.8);
      color: var(--muted-foreground);
      font-size: 0.8125rem;
      font-weight: 500;
      cursor: pointer;
      user-select: none;
    }
    summary::marker,
    summary::-webkit-details-marker {
      display: none;
    }
    summary:focus-visible {
      outline: 2px solid var(--ring);
      /* `!important` to beat the shared `summary:focus-visible` ring in
         navigation.css, which is unlayered and would otherwise win. */
      outline-offset: -2px !important;
    }
    @media (hover: hover) and (pointer: fine) {
      summary:hover {
        color: var(--foreground);
        background-color: var(--accent);
      }
    }

    .group-label {
      min-width: 0;
    }

    .caret {
      flex-shrink: 0;
      transition: transform 0.2s ease-in-out;
    }
    :global([dir="rtl"]) .caret {
      transform: rotateZ(180deg);
    }
    details[open] > summary .caret {
      transform: rotateZ(90deg);
    }

    a {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      width: fit-content;
      max-width: 100%;
      /* Single-line rows are exactly 30px (1.125rem line box + 2x0.375rem
         padding); long labels wrap and grow instead of escaping the pill. */
      min-height: 30px;
      line-height: 1.125rem;
      padding: 0.375rem 0.5rem;
      border-radius: calc(var(--radius) * 0.8);
      color: var(--foreground);
      font-size: 0.875rem;
      font-weight: 500;
      text-decoration: none;
      transition:
        background-color 0.15s ease,
        color 0.15s ease;
    }
    /* Full-row hit area: the pill stays content-width, the target does not
       (reference `.entry-link-inner`). The drawer widens the target to its own
       column through `--sidebar-row-hit`. */
    a > .row-hit-area {
      position: absolute;
      inset: 0;
      width: var(--sidebar-row-hit, 16rem);
    }
    a > span {
      min-width: 0;
    }
    a:focus-visible {
      outline: 2px solid var(--ring);
      outline-offset: -2px !important;
    }
    @media (hover: hover) and (pointer: fine) {
      a:hover {
        background-color: var(--accent);
        color: var(--sidebar-accent-foreground);
      }
    }
    a[aria-current="page"] {
      background-color: var(--accent);
      color: var(--sidebar-accent-foreground);
      font-weight: 500;
    }

    /* 44px-ish rows on coarse pointers; desktop keeps the compact 30px row. */
    @media (pointer: coarse) {
      summary {
        min-height: 44px;
      }
      a {
        min-height: 44px;
        padding-block: 0.6rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .caret,
      a {
        transition: none;
      }
    }
  }
</style>
