---
import { Icon } from "@astrojs/starlight/components";
---

<starlight-menu-button class="print:hidden">
  <button
    aria-expanded="false"
    aria-label={Astro.locals.t("menuButton.accessibleLabel")}
    aria-controls="starlight__sidebar"
  >
    <Icon name="bars" class="open-menu" />
    <Icon name="close" class="close-menu" />
  </button>
</starlight-menu-button>

<script>
  class StarlightMenuButton extends HTMLElement {
    btn = this.querySelector("button")!;

    constructor() {
      super();
      // Toggle `aria-expanded` state when a user clicks the button.
      this.btn.addEventListener("click", () => this.toggleExpanded());

      // Close the menu when a user presses the escape key. The trigger now lives
      // in the header, so the listener hangs off the document; the guard keeps
      // instances swapped out by view transitions from acting on the new page.
      document.addEventListener("keyup", (e) => {
        if (this.isConnected) this.closeOnEscape(e);
      });

      // The drawer only exists below 64rem; drop the lock when the rail docks.
      matchMedia("(min-width: 64rem)").addEventListener("change", (e) => {
        if (e.matches) this.setExpanded(false);
      });
    }

    setExpanded(expanded: boolean) {
      this.setAttribute("aria-expanded", String(expanded));
      document.body.toggleAttribute("data-mobile-menu-expanded", expanded);
      // Keep keyboard/SR focus out of the dimmed content behind the scrim
      // (matches Starlight's own MobileMenuToggle).
      document
        .querySelectorAll(".main-frame, .sl-skip-link")
        .forEach((el) => el.toggleAttribute("inert", expanded));
    }

    toggleExpanded() {
      this.setExpanded(this.getAttribute("aria-expanded") !== "true");
    }

    closeOnEscape(e: KeyboardEvent) {
      if (e.code === "Escape") {
        this.setExpanded(false);
        this.btn.focus();
      }
    }
  }

  customElements.define("starlight-menu-button", StarlightMenuButton);
</script>

<style>
  @layer starlight.core {
    /* In-flow header item: the drawer trigger sits beside the brand below 64rem
       and disappears once the rail docks. */
    starlight-menu-button {
      display: flex;
      flex-shrink: 0;
    }
    button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border: 0;
      border-radius: calc(var(--radius) - 2px);
      background-color: transparent;
      color: color-mix(in oklab, var(--foreground) 76%, var(--muted-foreground));
      cursor: pointer;
      transition:
        background-color 150ms ease-out,
        color 150ms ease-out;
    }
    @media (hover: hover) and (pointer: fine) {
      button:hover {
        background-color: color-mix(in oklab, var(--accent) 80%, transparent);
        color: var(--accent-foreground);
      }
    }
    button:focus-visible {
      outline: 2px solid var(--ring);
      outline-offset: 2px;
    }
    @media (prefers-reduced-motion: reduce) {
      button {
        transition: none;
      }
    }

    [aria-expanded="true"] button .open-menu {
      display: none;
    }
    :not([aria-expanded="true"]) button .close-menu {
      display: none;
    }

    @media (min-width: 64rem) {
      starlight-menu-button {
        display: none;
      }
    }
  }
</style>

<style is:global>
  @layer starlight.core {
    [data-mobile-menu-expanded] {
      overflow: hidden;
    }
  }
</style>
