---
/**
 * VimPlayground.astro — an interactive, in-page Vim editor for practicing
 * motions / operators (yank, delete, change, …) without leaving the docs.
 *
 * Built on CodeMirror 6 + @replit/codemirror-vim. No JS framework: the
 * interactivity is a vanilla-TS client `<script>` (bundled by Vite, browser
 * only — no SSR/Workers impact, same shape as Mermaid.astro). Astro props are
 * serialized into a `<script type="application/json">` so the client script can
 * read them (the SSR→client bridge).
 *
 * Usage (in an .mdx file):
 *   import VimPlayground from "~/components/VimPlayground.astro";
 *   <VimPlayground
 *     title="Yank a word"
 *     code={`const greeting = "hello world";`}
 *     lang="js"
 *     challenges={[
 *       {
 *         id: "yiw",
 *         prompt: "Put the cursor on `greeting` and yank the word with `yiw`.",
 *         hint: "i = inner. yiw works from anywhere inside the word.",
 *         solution: "yiw",
 *         success: { equals: "greeting" },
 *       },
 *     ]}
 *   />
 *
 * Each challenge passes when the unnamed register (or `success.register`) holds
 * the expected text and the buffer is still unchanged (so a *yank* counts but a
 * *delete* does not). See the Challenge interface below for the full contract.
 */
interface Challenge {
  /** Stable id (used as the dom key). */
  id: string;
  /** Plain text; backtick `code` spans are rendered as <code>. */
  prompt: string;
  /** Optional revealable hint. */
  hint?: string;
  /** Optional revealable keystrokes, e.g. "yiw". */
  solution?: string;
  success: {
    /** Register to inspect. Default '"' (the unnamed register). */
    register?: string;
    /** Exact register contents. */
    equals?: string;
    /** Regex source (alternative to equals). */
    matches?: string;
    /** Require a linewise yank. */
    linewise?: boolean;
    /** Default true → register match only counts if the buffer is unchanged
     *  (distinguishes yank from delete). Ignored when `buffer` is set. */
    bufferUnchanged?: boolean;
    /** For delete/change lessons: require the buffer to equal this. */
    buffer?: { equals: string };
    /** Optional expected vim mode. */
    mode?: string;
  };
}
interface Props {
  /** Initial buffer (whitespace preserved exactly via JSON). */
  code: string;
  /** Language for syntax highlighting. Default "js". */
  lang?: "js" | "ts" | "text";
  /** Editor viewport height in px (fixed → no layout shift). Default 280. */
  height?: number;
  /** Header label. Default "Vim playground". */
  title?: string;
  /** Optional small caption under the widget. */
  caption?: string;
  /** Practice challenges (declarative; no code needed to add a lesson). */
  challenges?: Challenge[];
}

const {
  code,
  lang = "js",
  height = 280,
  title = "Vim playground",
  caption,
  challenges = [],
} = Astro.props;

// SSR→client bridge: the client `<script>` can't see Astro props, so we ship
// the bits it needs as JSON. JSON.stringify preserves the exact whitespace of
// `code`, which is essential for a faithful buffer.
const config = JSON.stringify({ code, lang, challenges });

/** Render backtick `code` spans in a challenge prompt as <code>. */
function escapeHtml(s: string): string {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}
function renderPrompt(text: string): string {
  return escapeHtml(text).replace(
    /`([^`]+)`/g,
    (_m, inner) => `<code>${inner}</code>`,
  );
}
---

<div class="vim-playground" style={`--vim-height:${height}px`}>
  <script is:inline type="application/json" class="vim-pg-config" set:html={config} />

  <div class="vim-pg-card">
    <div class="vim-pg-header">
      <span class="vim-pg-title">
        <span class="vim-pg-glyph" aria-hidden="true">⌨</span>
        {title}
      </span>
      <div class="vim-pg-tools">
        <span class="vim-pg-keys" aria-hidden="true"></span>
        <span class="vim-pg-reg" title="unnamed register">
          <span class="vim-pg-reg-label">reg&nbsp;"</span>
          <span class="vim-pg-reg-val">—</span>
          <span class="vim-pg-reg-lw" hidden>LW</span>
        </span>
        <button type="button" class="vim-pg-reset" title="Reset buffer">Reset</button>
      </div>
    </div>

    <div class="vim-pg-editor"></div>
  </div>

  {
    caption && <p class="vim-pg-caption">{caption}</p>
  }

  <div class="vim-pg-touch" hidden>
    <span>Vim practice needs a physical keyboard — best on desktop.</span>
    <button type="button" class="vim-pg-touch-dismiss" aria-label="Dismiss">×</button>
  </div>

  {
    challenges.length > 0 && (
      <ul class="vim-pg-challenges">
        {challenges.map((c) => (
          <li class="vim-pg-challenge" data-cid={c.id}>
            <span class="vim-pg-dot" aria-hidden="true" />
            <div class="vim-pg-cbody">
              <div class="vim-pg-prompt" set:html={renderPrompt(c.prompt)} />
              <div class="vim-pg-cactions">
                {c.hint && (
                  <button type="button" class="vim-pg-toggle" data-toggle="hint">
                    Hint
                  </button>
                )}
                {c.solution && (
                  <button type="button" class="vim-pg-toggle" data-toggle="solution">
                    Show keys
                  </button>
                )}
              </div>
              {c.hint && (
                <p class="vim-pg-hint" hidden>
                  {c.hint}
                </p>
              )}
              {c.solution && (
                <p class="vim-pg-solution" hidden>
                  <kbd>{c.solution}</kbd>
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .vim-playground {
    margin: 1.75rem 0;
    --vim-mono: var(
      --__sl-font-mono,
      ui-monospace,
      SFMono-Regular,
      "SF Mono",
      Menlo,
      Consolas,
      monospace
    );
  }

  .vim-pg-card {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    background: var(--sl-color-black);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }
  .vim-pg-card:focus-within {
    border-color: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
  }

  .vim-pg-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.4rem 0.5rem 0.4rem 0.85rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    background: color-mix(in srgb, var(--sl-color-white) 3%, transparent);
  }
  .vim-pg-title {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: color-mix(in srgb, var(--sl-color-white) 78%, transparent);
    white-space: nowrap;
  }
  .vim-pg-glyph {
    font-size: 0.9rem;
    line-height: 1;
    color: color-mix(in srgb, var(--sl-color-accent) 90%, var(--sl-color-white));
  }

  .vim-pg-tools {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
  }

  .vim-pg-keys {
    font-family: var(--vim-mono);
    font-size: 0.72rem;
    color: color-mix(in srgb, var(--sl-color-white) 55%, transparent);
    letter-spacing: 0.04em;
    min-width: 0;
    max-width: 9ch;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .vim-pg-keys.is-active {
    opacity: 1;
  }

  .vim-pg-reg {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    max-width: 18ch;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 7px;
    background: color-mix(in srgb, var(--sl-color-white) 4%, transparent);
    font-family: var(--vim-mono);
    font-size: 0.72rem;
    line-height: 1.4;
  }
  .vim-pg-reg-label {
    color: color-mix(in srgb, var(--sl-color-white) 50%, transparent);
    white-space: nowrap;
  }
  .vim-pg-reg-val {
    color: color-mix(in srgb, var(--sl-color-white) 85%, transparent);
    max-width: 11ch;
    overflow: hidden;
    white-space: pre;
    text-overflow: ellipsis;
  }
  .vim-pg-reg-val.is-empty {
    color: color-mix(in srgb, var(--sl-color-white) 35%, transparent);
  }
  .vim-pg-reg-lw {
    padding: 0 0.25rem;
    border-radius: 4px;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--sl-color-black);
    background: color-mix(in srgb, var(--sl-color-accent) 80%, var(--sl-color-white));
  }

  .vim-pg-reset {
    flex: none;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 7px;
    background: transparent;
    color: color-mix(in srgb, var(--sl-color-white) 72%, transparent);
    font-size: 0.72rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .vim-pg-reset:hover {
    color: var(--sl-color-accent);
    border-color: color-mix(in srgb, var(--sl-color-accent) 50%, transparent);
    background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
  }

  /* The editor viewport: fixed height, internal scroll → no layout shift. */
  .vim-pg-editor {
    height: var(--vim-height, 280px);
    overflow: hidden;
  }

  /* --- CodeMirror chrome (theme-agnostic structural rules) --- */
  .vim-pg-editor :global(.cm-editor) {
    height: 100%;
    background: transparent;
    font-family: var(--vim-mono);
    font-size: 0.85rem;
  }
  .vim-pg-editor :global(.cm-editor.cm-focused) {
    outline: none !important;
  }
  .vim-pg-editor :global(.cm-scroller) {
    overflow: auto;
    font-family: var(--vim-mono);
    line-height: 1.6;
  }
  .vim-pg-editor :global(.cm-gutters) {
    background: transparent;
    border-right: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-4);
  }
  .vim-pg-editor :global(.cm-content) {
    caret-color: var(--sl-color-accent);
  }

  /* Block cursor (normal / visual). Insert keeps the default thin caret. */
  .vim-pg-editor :global(.cm-fat-cursor .cm-cursor),
  .vim-pg-editor :global(.cm-cursor.cm-fat-cursor) {
    background: color-mix(in srgb, var(--sl-color-accent) 70%, transparent);
    border: none;
    color: var(--sl-color-black);
  }
  /* When not focused, fat cursor shows as a hollow box (vim convention). */
  .vim-pg-editor :global(.cm-editor:not(.cm-focused) .cm-fat-cursor) {
    background: none;
    outline: 1px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    outline-offset: -1px;
  }

  /* Official vim status bar (status:true) — mode line + :/​ command line. */
  .vim-pg-editor :global(.cm-vim-panel) {
    padding: 0.2rem 0.65rem;
    border-top: 1px solid var(--sl-color-hairline);
    background: transparent;
    font-family: var(--vim-mono);
    font-size: 12px;
    line-height: 1.5;
    color: color-mix(in srgb, var(--sl-color-white) 55%, transparent);
  }
  .vim-pg-editor :global(.cm-vim-panel input),
  .vim-pg-editor :global(.cm-vim-message) {
    font-family: var(--vim-mono);
    font-size: 12px;
    color: color-mix(in srgb, var(--sl-color-white) 72%, transparent);
    background: transparent;
    border: none;
    outline: none;
  }
  .vim-pg-editor :global(.cm-vim-panel input) {
    width: 100%;
  }

  .vim-pg-caption {
    margin: 0.55rem 0.15rem 0;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--sl-color-white) 60%, transparent);
  }

  .vim-pg-touch {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.6rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 28%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--sl-color-accent) 6%, transparent);
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--sl-color-white) 78%, transparent);
  }
  .vim-pg-touch-dismiss {
    flex: none;
    border: none;
    background: transparent;
    color: inherit;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.7;
  }
  .vim-pg-touch-dismiss:hover {
    opacity: 1;
  }

  /* --- Challenges --- */
  .vim-pg-challenges {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .vim-pg-challenge {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 0;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--sl-color-hairline);
    border-left: 2px solid var(--sl-color-hairline);
    border-radius: 9px;
    background: transparent;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
  }
  .vim-pg-challenge.is-solved {
    background: color-mix(in srgb, var(--sl-color-accent) 6%, transparent);
    border-color: color-mix(in srgb, var(--sl-color-accent) 22%, transparent);
    border-left-color: color-mix(in srgb, var(--sl-color-accent) 70%, transparent);
  }
  .vim-pg-dot {
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 0.2rem;
    border: 1.5px solid var(--sl-color-gray-4);
    border-radius: 50%;
    position: relative;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease;
  }
  .vim-pg-challenge.is-solved .vim-pg-dot {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
  }
  .vim-pg-challenge.is-solved .vim-pg-dot::after {
    content: "";
    position: absolute;
    left: 4px;
    top: 1px;
    width: 3px;
    height: 6px;
    border: solid var(--sl-color-black);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }
  .vim-pg-cbody {
    flex: 1;
    min-width: 0;
  }
  .vim-pg-prompt {
    font-size: 0.875rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--sl-color-white) 88%, transparent);
  }
  .vim-pg-prompt :global(code) {
    font-family: var(--vim-mono);
    font-size: 0.82em;
    padding: 0.05em 0.35em;
    border-radius: 5px;
    background: color-mix(in srgb, var(--sl-color-white) 8%, transparent);
  }
  .vim-pg-cactions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.3rem;
  }
  .vim-pg-toggle {
    padding: 0;
    border: none;
    background: transparent;
    color: color-mix(in srgb, var(--sl-color-accent) 90%, var(--sl-color-white));
    font-size: 0.74rem;
    font-weight: 500;
    cursor: pointer;
    opacity: 0.85;
  }
  .vim-pg-toggle:hover {
    opacity: 1;
    text-decoration: underline;
  }
  .vim-pg-hint {
    margin: 0.4rem 0 0;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--sl-color-white) 65%, transparent);
  }
  .vim-pg-solution {
    margin: 0.4rem 0 0;
  }
  .vim-pg-solution :global(kbd) {
    font-family: var(--vim-mono);
    font-size: 0.78rem;
    padding: 0.12em 0.5em;
    border: 1px solid var(--sl-color-hairline);
    border-bottom-width: 2px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--sl-color-white) 6%, transparent);
    color: color-mix(in srgb, var(--sl-color-white) 90%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .vim-pg-challenge.is-glow {
      animation: vim-pg-glow 0.9s ease;
    }
    @keyframes vim-pg-glow {
      0% {
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
      }
      100% {
        box-shadow: 0 0 0 8px transparent;
      }
    }
  }
</style>

<script>
  import { EditorState, Compartment } from "@codemirror/state";
  import {
    EditorView,
    lineNumbers,
    highlightSpecialChars,
    drawSelection,
    dropCursor,
  } from "@codemirror/view";
  import { history } from "@codemirror/commands";
  import { HighlightStyle, syntaxHighlighting } from "@codemirror/language";
  import { javascript } from "@codemirror/lang-javascript";
  import { tags as t } from "@lezer/highlight";
  import { vim, Vim, getCM } from "@replit/codemirror-vim";
  import type { Extension } from "@codemirror/state";

  type Challenge = {
    id: string;
    prompt: string;
    hint?: string;
    solution?: string;
    success: {
      register?: string;
      equals?: string;
      matches?: string;
      linewise?: boolean;
      bufferUnchanged?: boolean;
      buffer?: { equals: string };
      mode?: string;
    };
  };
  type Config = {
    code: string;
    lang: "js" | "ts" | "text";
    challenges: Challenge[];
  };

  const isLight = () => document.documentElement.dataset.theme === "light";

  // github-dark-default-ish syntax colors.
  const darkHighlight = HighlightStyle.define([
    { tag: [t.keyword, t.modifier, t.operatorKeyword], color: "#ff7b72" },
    { tag: [t.controlKeyword, t.moduleKeyword], color: "#ff7b72" },
    { tag: [t.definitionKeyword, t.typeName, t.className], color: "#ff7b72" },
    { tag: [t.string, t.special(t.string), t.regexp], color: "#a5d6ff" },
    { tag: [t.function(t.variableName), t.function(t.propertyName)], color: "#d2a8ff" },
    { tag: [t.number, t.bool, t.null], color: "#79c0ff" },
    { tag: [t.comment, t.lineComment, t.blockComment], color: "#8b949e", fontStyle: "italic" },
    { tag: [t.propertyName], color: "#79c0ff" },
    { tag: [t.variableName], color: "#e6edf3" },
    { tag: [t.operator, t.punctuation, t.separator], color: "#c9d1d9" },
  ]);

  // github-light-default-ish syntax colors.
  const lightHighlight = HighlightStyle.define([
    { tag: [t.keyword, t.modifier, t.operatorKeyword], color: "#cf222e" },
    { tag: [t.controlKeyword, t.moduleKeyword], color: "#cf222e" },
    { tag: [t.definitionKeyword, t.typeName, t.className], color: "#cf222e" },
    { tag: [t.string, t.special(t.string), t.regexp], color: "#0a3069" },
    { tag: [t.function(t.variableName), t.function(t.propertyName)], color: "#8250df" },
    { tag: [t.number, t.bool, t.null], color: "#0550ae" },
    { tag: [t.comment, t.lineComment, t.blockComment], color: "#6e7781", fontStyle: "italic" },
    { tag: [t.propertyName], color: "#0550ae" },
    { tag: [t.variableName], color: "#24292f" },
    { tag: [t.operator, t.punctuation, t.separator], color: "#24292f" },
  ]);

  const editorTheme = (light: boolean) =>
    EditorView.theme(
      {
        "&": {
          color: light ? "#1f2328" : "#e6edf3",
          backgroundColor: "transparent",
        },
        ".cm-content": {
          padding: "0.6rem 0",
          caretColor: light ? "#16A34A" : "#22C55E",
        },
        ".cm-gutters": {
          backgroundColor: "transparent",
          border: "none",
          color: light ? "#8b8b8b" : "#585858",
        },
        ".cm-gutter.cm-lineNumbers .cm-gutterElement": {
          padding: "0 0.5rem 0 0.75rem",
        },
        ".cm-selectionBackground": {
          backgroundColor: light
            ? "color-mix(in srgb, #16A34A 25%, transparent)"
            : "color-mix(in srgb, #22C55E 25%, transparent)",
        },
        "&.cm-focused .cm-selectionBackground, ::selection": {
          backgroundColor: light
            ? "color-mix(in srgb, #16A34A 25%, transparent)"
            : "color-mix(in srgb, #22C55E 28%, transparent)",
        },
        ".cm-activeLine": { backgroundColor: "transparent" },
      },
      { dark: !light },
    );

  // Both the chrome theme AND the matching syntax highlight live in the
  // compartment so a single reconfigure swaps light↔dark in one shot.
  const themeFor = (light: boolean): Extension => [
    editorTheme(light),
    syntaxHighlighting(light ? lightHighlight : darkHighlight),
  ];

  function langExtension(lang: Config["lang"]): Extension | null {
    if (lang === "ts") return javascript({ typescript: true });
    if (lang === "js") return javascript();
    return null; // "text" → no language
  }

  // Track live views so the theme observer + teardown can reach them.
  const liveViews = new Set<{
    root: HTMLElement;
    view: EditorView;
    themeCompartment: Compartment;
    detach: () => void;
  }>();

  function readRegister(name: string): {
    text: string;
    linewise: boolean;
    blockwise: boolean;
  } {
    try {
      const reg = Vim.getRegisterController().getRegister(name);
      if (!reg) return { text: "", linewise: false, blockwise: false };
      return {
        text: reg.toString() ?? "",
        linewise: !!reg.linewise,
        blockwise: !!reg.blockwise,
      };
    } catch {
      return { text: "", linewise: false, blockwise: false };
    }
  }

  function initRoot(root: HTMLElement) {
    if (root.hasAttribute("data-vim-ready")) return;

    const cfgEl = root.querySelector<HTMLElement>(".vim-pg-config");
    const editorEl = root.querySelector<HTMLElement>(".vim-pg-editor");
    if (!cfgEl || !editorEl) return;

    let cfg: Config;
    try {
      cfg = JSON.parse(cfgEl.textContent || "{}");
    } catch {
      return;
    }
    if (typeof cfg.code !== "string") return;

    root.setAttribute("data-vim-ready", "");

    const initialCode = cfg.code;
    const challenges = Array.isArray(cfg.challenges) ? cfg.challenges : [];
    const solved = new Set<string>();

    const regValEl = root.querySelector<HTMLElement>(".vim-pg-reg-val");
    const regLwEl = root.querySelector<HTMLElement>(".vim-pg-reg-lw");
    const keysEl = root.querySelector<HTMLElement>(".vim-pg-keys");
    const resetBtn = root.querySelector<HTMLButtonElement>(".vim-pg-reset");

    const themeCompartment = new Compartment();

    const extensions: Extension[] = [
      // vim MUST be first so its keymap wins.
      vim({ status: true }),
      lineNumbers(),
      highlightSpecialChars(),
      history(),
      drawSelection(),
      dropCursor(),
      EditorState.allowMultipleSelections.of(true),
      EditorView.lineWrapping,
    ];
    const le = langExtension(cfg.lang);
    if (le) extensions.push(le);
    extensions.push(themeCompartment.of(themeFor(isLight())));

    // Register + challenge refresh (best-effort, never throws).
    let currentMode = "normal";

    const refresh = () => {
      try {
        const reg = readRegister('"');
        if (regValEl) {
          if (reg.text === "") {
            regValEl.textContent = "—";
            regValEl.classList.add("is-empty");
          } else {
            // single-line preview; show raw newlines as ⏎ glyph
            regValEl.textContent = reg.text.replace(/\n/g, "⏎");
            regValEl.classList.remove("is-empty");
          }
        }
        if (regLwEl) regLwEl.hidden = !reg.linewise;
        evaluateChallenges();
      } catch {
        /* degrade silently */
      }
    };

    const evaluateChallenges = () => {
      const docText = view.state.doc.toString();
      for (const c of challenges) {
        if (solved.has(c.id)) continue;
        const s = c.success || {};
        const reg = readRegister(s.register ?? '"');

        // mode gate
        if (s.mode && currentMode !== s.mode) continue;

        // register contents gate
        let regOk = true;
        if (typeof s.equals === "string") {
          // Tolerate a single trailing-newline difference: linewise registers
          // may or may not carry the trailing "\n" depending on the engine.
          // Safe because linewise yanks are still gated on `reg.linewise` below.
          regOk =
            reg.text === s.equals ||
            reg.text === s.equals + "\n" ||
            reg.text + "\n" === s.equals;
        } else if (typeof s.matches === "string") {
          try {
            regOk = new RegExp(s.matches).test(reg.text);
          } catch {
            regOk = false;
          }
        }
        if (!regOk) continue;

        if (typeof s.linewise === "boolean" && reg.linewise !== s.linewise) {
          continue;
        }

        // buffer gate
        if (s.buffer && typeof s.buffer.equals === "string") {
          if (docText !== s.buffer.equals) continue;
        } else if (s.bufferUnchanged !== false) {
          // default: require an unchanged buffer (yank, not delete)
          if (docText !== initialCode) continue;
        }

        markSolved(c.id);
      }
    };

    const markSolved = (id: string) => {
      if (solved.has(id)) return;
      solved.add(id);
      const li = root.querySelector<HTMLElement>(
        `.vim-pg-challenge[data-cid="${cssEscape(id)}"]`,
      );
      if (!li) return;
      li.classList.add("is-solved", "is-glow");
      setTimeout(() => li.classList.remove("is-glow"), 950);
    };

    const updateListener = EditorView.updateListener.of((u) => {
      if (u.docChanged || u.selectionSet) refresh();
    });
    extensions.push(updateListener);

    const view = new EditorView({
      doc: initialCode,
      extensions,
      parent: editorEl,
    });

    // Mode tracking via the cm5-compat adapter.
    const cm = getCM(view);
    const onModeChange = (e: { mode?: string; subMode?: string }) => {
      currentMode = e?.mode || "normal";
      // a yank does not change the doc → updateListener won't fire; refresh here
      scheduleRefresh();
      clearKeysSoon();
    };
    if (cm) cm.on("vim-mode-change", onModeChange);

    // rAF-coalesced refresh so we read the register *after* vim handles a key.
    let rafId = 0;
    const scheduleRefresh = () => {
      if (rafId) return;
      rafId = requestAnimationFrame(() => {
        rafId = 0;
        refresh();
      });
    };

    // Keydown (capture) → schedule a post-key refresh (catches yiw etc. that
    // don't change the doc) + best-effort keystroke echo.
    let keysBuf = "";
    let keysTimer: ReturnType<typeof setTimeout> | undefined;
    const clearKeysSoon = () => {
      if (keysTimer) clearTimeout(keysTimer);
      keysTimer = setTimeout(() => {
        keysBuf = "";
        if (keysEl) {
          keysEl.textContent = "";
          keysEl.classList.remove("is-active");
        }
      }, 900);
    };
    const onKeyDown = (e: KeyboardEvent) => {
      try {
        const k = e.key;
        if (k && k.length === 1) {
          keysBuf = (keysBuf + k).slice(-12);
        } else if (k === "Escape") {
          keysBuf = (keysBuf + "⎋").slice(-12);
        } else if (k === "Enter") {
          keysBuf = (keysBuf + "⏎").slice(-12);
        }
        if (keysEl && keysBuf) {
          keysEl.textContent = keysBuf;
          keysEl.classList.add("is-active");
        }
        clearKeysSoon();
      } catch {
        /* echo must never break input */
      }
      scheduleRefresh();
    };
    editorEl.addEventListener("keydown", onKeyDown, true);

    // Reset → restore buffer, clear challenge state, refocus.
    const onReset = () => {
      view.dispatch({
        changes: { from: 0, to: view.state.doc.length, insert: initialCode },
        selection: { anchor: 0 },
      });
      solved.clear();
      root.querySelectorAll(".vim-pg-challenge").forEach((li) => {
        li.classList.remove("is-solved", "is-glow");
      });
      refresh();
      view.focus();
    };
    resetBtn?.addEventListener("click", onReset);

    // Hint / Show keys toggles.
    root.querySelectorAll<HTMLButtonElement>(".vim-pg-toggle").forEach((btn) => {
      btn.addEventListener("click", () => {
        const kind = btn.dataset.toggle; // "hint" | "solution"
        const li = btn.closest(".vim-pg-challenge");
        const target = li?.querySelector<HTMLElement>(
          kind === "hint" ? ".vim-pg-hint" : ".vim-pg-solution",
        );
        if (target) target.hidden = !target.hidden;
      });
    });

    const detach = () => {
      try {
        if (cm) cm.off("vim-mode-change", onModeChange);
      } catch {
        /* ignore */
      }
      editorEl.removeEventListener("keydown", onKeyDown, true);
      if (rafId) cancelAnimationFrame(rafId);
      if (keysTimer) clearTimeout(keysTimer);
      try {
        view.destroy();
      } catch {
        /* ignore */
      }
    };

    const record = { root, view, themeCompartment, detach };
    liveViews.add(record);
    (root as any)._vimView = view;
    (root as any)._vimRecord = record;

    refresh();
  }

  // Minimal CSS.escape fallback for attribute selectors.
  function cssEscape(s: string): string {
    if (typeof (window as any).CSS?.escape === "function") {
      return (window as any).CSS.escape(s);
    }
    return s.replace(/["\\\]]/g, "\\$&");
  }

  function showTouchNote() {
    if (!matchMedia("(pointer: coarse)").matches) return;
    document
      .querySelectorAll<HTMLElement>(".vim-playground .vim-pg-touch")
      .forEach((note) => {
        if (note.dataset.vimTouchShown) return;
        note.dataset.vimTouchShown = "1";
        note.hidden = false;
        note
          .querySelector(".vim-pg-touch-dismiss")
          ?.addEventListener("click", () => {
            note.hidden = true;
          });
      });
  }

  function init() {
    document
      .querySelectorAll<HTMLElement>(".vim-playground:not([data-vim-ready])")
      .forEach((root) => initRoot(root));
    showTouchNote();
  }

  // Tear down views whose roots are leaving (view transitions / swaps).
  function teardownStale() {
    for (const rec of [...liveViews]) {
      if (!document.contains(rec.root)) {
        rec.detach();
        liveViews.delete(rec);
      }
    }
  }

  // Theme: reconfigure every live view's compartment when data-theme flips.
  let themeTimer: ReturnType<typeof setTimeout>;
  new MutationObserver(() => {
    clearTimeout(themeTimer);
    themeTimer = setTimeout(() => {
      const light = isLight();
      for (const rec of liveViews) {
        try {
          rec.view.dispatch({
            effects: rec.themeCompartment.reconfigure(themeFor(light)),
          });
        } catch {
          /* ignore */
        }
      }
    }, 60);
  }).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });

  document.addEventListener("astro:page-load", () => {
    teardownStale();
    init();
  });
  document.addEventListener("astro:before-swap", teardownStale);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
