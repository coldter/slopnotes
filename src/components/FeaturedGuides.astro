---
import { getCollection } from "astro:content";
import { Icon } from "@astrojs/starlight/components";
import { plainLabel } from "../lib/utils/textConverter.ts";

// Mirrors CourseCatalog's data logic: each top-level sidebar group is one guide.
const sidebar = Astro.locals.starlightRoute.sidebar;
const docs = await getCollection("docs");

function firstHref(item: any): string | null {
  if (typeof item?.href === "string" && item.href) return item.href;
  if (Array.isArray(item?.entries) && item.entries.length) {
    return firstHref(item.entries[0]);
  }
  return null;
}

function countLessons(item: any): number {
  if (item?.type === "link" || typeof item?.href === "string") return 1;
  if (Array.isArray(item?.entries)) {
    return item.entries.reduce((n: number, e: any) => n + countLessons(e), 0);
  }
  return 0;
}

function descriptionFor(href: string | null): string {
  if (!href) return "";
  const slug = href.replace(/^\/+/, "").replace(/\/+$/, "");
  const doc = docs.find((d) => d.id === slug || d.id === `${slug}/index`);
  return doc?.data?.description ?? "";
}

const guides = sidebar
  .filter((item: any) => item.type !== "link")
  .map((item: any) => {
    const href = firstHref(item);
    return {
      label: plainLabel(item.label),
      href,
      lessons: countLessons(item),
      description: descriptionFor(href),
    };
  })
  .filter((g: any) => g.href);
---

<section class="featured">
  <div class="featured-head">
    <span class="kicker">&gt;_ browse by topic</span>
    <h2>{guides.length} guides, one place to read them</h2>
  </div>

  <ul class="guide-grid">
    {
      guides.map((g: any) => (
        <li>
          <a class="guide-card no-underline" href={g.href}>
            <div class="guide-card-top">
              <h3>{g.label}</h3>
              <Icon name="right-arrow" class="guide-arrow" size="1.1rem" />
            </div>
            {g.description && <p class="guide-desc">{g.description}</p>}
            <span class="guide-meta">
              {g.lessons} {g.lessons === 1 ? "page" : "pages"}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .featured {
    width: 100%;
    max-width: 64rem;
    margin: 0 auto;
    padding: 1rem 1.25rem 5rem;
  }

  .featured-head {
    text-align: center;
    margin-bottom: 2rem;
  }
  .kicker {
    display: inline-block;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--sl-color-accent);
    margin-bottom: 0.6rem;
  }
  .featured-head h2 {
    margin: 0;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.6rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--sl-color-white);
    border: 0;
  }

  .guide-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 14px;
    background: var(--sl-color-black);
    text-decoration: none;
    transition:
      border-color 0.18s ease,
      background-color 0.18s ease,
      transform 0.18s ease;
  }
  .guide-card:hover,
  .guide-card:focus-visible {
    border-color: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    background: color-mix(in srgb, var(--sl-color-accent) 6%, var(--sl-color-black));
    transform: translateY(-3px);
  }

  .guide-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .guide-card-top h3 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .guide-arrow {
    flex-shrink: 0;
    color: color-mix(in srgb, var(--sl-color-white) 55%, transparent);
    transition:
      color 0.18s ease,
      transform 0.18s ease;
  }
  .guide-card:hover .guide-arrow,
  .guide-card:focus-visible .guide-arrow {
    color: var(--sl-color-accent);
    transform: translateX(3px);
  }

  .guide-desc {
    margin: 0.55rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--sl-color-white) 70%, transparent);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .guide-meta {
    margin-top: auto;
    padding-top: 0.9rem;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--sl-color-white) 55%, transparent);
  }
</style>
