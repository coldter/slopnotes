---
import { getCollection } from "astro:content";
import { Icon } from "@astrojs/starlight/components";
import { plainLabel } from "../lib/utils/textConverter.ts";

// The catalog is derived from the same sidebar config that drives navigation,
// so adding a course (folder + sidebar.json entry) makes it appear here with
// no extra wiring. Each top-level sidebar group is treated as one course.
const sidebar = Astro.locals.starlightRoute.sidebar;
const docs = await getCollection("docs");

function firstHref(item: any): string | null {
  if (typeof item?.href === "string" && item.href) return item.href;
  if (Array.isArray(item?.entries) && item.entries.length) {
    return firstHref(item.entries[0]);
  }
  return null;
}

function countLessons(item: any): number {
  if (item?.type === "link" || typeof item?.href === "string") return 1;
  if (Array.isArray(item?.entries)) {
    return item.entries.reduce((n: number, e: any) => n + countLessons(e), 0);
  }
  return 0;
}

// Pull the course blurb from its landing page's frontmatter description.
function descriptionFor(href: string | null): string {
  if (!href) return "";
  const slug = href.replace(/^\/+/, "").replace(/\/+$/, "");
  const doc = docs.find((d) => d.id === slug || d.id === `${slug}/index`);
  return doc?.data?.description ?? "";
}

const courses = sidebar
  .filter((item: any) => item.type !== "link")
  .map((item: any) => {
    const href = firstHref(item);
    return {
      label: plainLabel(item.label),
      href,
      lessons: countLessons(item),
      description: descriptionFor(href),
    };
  })
  .filter((c: any) => c.href);
---

<div class="catalog">
  <ul class="course-list">
    {
      courses.map((course: any) => (
        <li>
          <a class="course-card" href={course.href}>
            <div class="course-body">
              <h2 class="course-title">{course.label}</h2>
              {course.description && (
                <p class="course-desc">{course.description}</p>
              )}
              <span class="course-meta">
                {course.lessons} {course.lessons === 1 ? "page" : "pages"}
              </span>
            </div>
            <Icon name="right-arrow" class="course-arrow" size="1.25rem" />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .catalog {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .course-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .course-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.4rem 1.6rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 14px;
    background: var(--sl-color-black);
    text-decoration: none;
    transition:
      border-color 0.18s ease,
      background-color 0.18s ease,
      transform 0.18s ease;
  }

  .course-card:hover,
  .course-card:focus-visible {
    border-color: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    background: color-mix(in srgb, var(--sl-color-accent) 5%, var(--sl-color-black));
    transform: translateY(-2px);
  }

  .course-body {
    flex: 1 1 auto;
    min-width: 0;
  }

  .course-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--sl-color-white);
  }

  .course-desc {
    margin: 0.4rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--sl-color-white) 78%, transparent);
  }

  .course-meta {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--sl-color-white) 68%, transparent);
  }

  .course-arrow {
    flex-shrink: 0;
    color: color-mix(in srgb, var(--sl-color-white) 58%, transparent);
    transition:
      color 0.18s ease,
      transform 0.18s ease;
  }

  .course-card:hover .course-arrow,
  .course-card:focus-visible .course-arrow {
    color: var(--sl-color-accent);
    transform: translateX(3px);
  }
</style>
