---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Icon } from "@astrojs/starlight/components";
import { plainLabel, getIconFromLabel } from "../lib/utils/textConverter.ts";

// The catalog is derived from the same sidebar config that drives navigation,
// so adding a course (folder + sidebar.json entry) makes it appear here with
// no extra wiring. Each top-level sidebar group is treated as one course.
const sidebar = Astro.locals.starlightRoute.sidebar;
const docs = await getCollection("docs");

function firstHref(item: any): string | null {
  if (typeof item?.href === "string" && item.href) return item.href;
  if (Array.isArray(item?.entries) && item.entries.length) {
    return firstHref(item.entries[0]);
  }
  return null;
}

function countLessons(item: any): number {
  if (item?.type === "link" || typeof item?.href === "string") return 1;
  if (Array.isArray(item?.entries)) {
    return item.entries.reduce((n: number, e: any) => n + countLessons(e), 0);
  }
  return 0;
}

// Pull the course blurb from its landing page's frontmatter description.
function descriptionFor(href: string | null): string {
  if (!href) return "";
  const slug = href.replace(/^\/+/, "").replace(/\/+$/, "");
  const doc = docs.find(
    (d: CollectionEntry<"docs">) => d.id === slug || d.id === `${slug}/index`
  );
  return doc?.data?.description ?? "";
}

const FALLBACK_BLURB =
  "A self-contained set of study notes — open the guide to start reading.";

const courses = sidebar
  .filter((item: any) => item.type !== "link")
  .map((item: any) => {
    const href = firstHref(item);
    const description = descriptionFor(href);
    return {
      label: plainLabel(item.label),
      // Sidebar labels may carry a `[icon-name]` tag; fall back to a neutral
      // book glyph when none is present.
      icon: getIconFromLabel(item.label) ?? "open-book",
      href,
      lessons: countLessons(item),
      description,
      blurb: description || FALLBACK_BLURB,
    };
  })
  .filter((c: any) => c.href);

const totalPages = courses.reduce((n: number, c: any) => n + c.lessons, 0);
---

<div class="catalog" data-catalog data-total-pages={totalPages}>
  <div class="catalog-head">
    <p class="catalog-count" data-catalog-status role="status">
      {courses.length} {courses.length === 1 ? "guide" : "guides"} · {
        totalPages
      } pages
    </p>
    <div class="catalog-filter">
      <label class="sr-only" for="catalog-filter">Filter guides</label>
      <span class="catalog-filter-icon" aria-hidden="true">
        <Icon name="magnifier" size="1rem" />
      </span>
      <input
        id="catalog-filter"
        class="catalog-filter-input"
        type="search"
        placeholder="Filter guides…"
        autocomplete="off"
        data-catalog-filter
      />
    </div>
  </div>

  <ul class="course-list">
    {
      courses.map((course: any) => (
        <li
          data-catalog-item
          data-search={`${course.label} ${course.description}`.toLowerCase()}
        >
          <a class="course-card" href={course.href}>
            <span class="course-chip" aria-hidden="true">
              <Icon name={course.icon as any} size="1.15rem" />
            </span>
            <span class="course-body">
              <span class="course-title">{course.label}</span>
              <span class="course-desc">{course.blurb}</span>
              <span class="course-foot">
                <span class="course-meta">
                  {course.lessons} {course.lessons === 1 ? "page" : "pages"}
                </span>
                <span class="course-start">
                  Start
                  <Icon
                    name="right-arrow"
                    size="1rem"
                    class="course-arrow"
                  />
                </span>
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="catalog-empty" data-catalog-empty hidden>
    <p>
      No guides match “<span data-catalog-query></span>”.
    </p>
    <button type="button" class="catalog-reset" data-catalog-reset>
      Clear search
    </button>
  </div>
</div>

<script>
  // Guarded so Astro view transitions don't stack duplicate listeners —
  // the delegated handlers below survive DOM swaps.
  const globalWindow = window as typeof window & {
    __slopnotesCatalogFilter?: boolean;
  };
  if (!globalWindow.__slopnotesCatalogFilter) {
    globalWindow.__slopnotesCatalogFilter = true;

    const applyFilter = (root: Element): void => {
      const input =
        root.querySelector<HTMLInputElement>("[data-catalog-filter]");
      const status = root.querySelector("[data-catalog-status]");
      const empty = root.querySelector("[data-catalog-empty]");
      const queryEl = root.querySelector("[data-catalog-query]");
      if (!input || !status) return;
      const q = input.value.trim().toLowerCase();
      const items = Array.from(
        root.querySelectorAll<HTMLElement>("[data-catalog-item]")
      );
      let visible = 0;
      items.forEach((li) => {
        const hay = li.getAttribute("data-search") ?? "";
        const show = !q || hay.includes(q);
        li.hidden = !show;
        if (show) visible++;
      });
      const pages = root.getAttribute("data-total-pages") ?? "0";
      if (!q) {
        status.textContent =
          items.length +
          (items.length === 1 ? " guide · " : " guides · ") +
          pages +
          " pages";
      } else {
        status.textContent = visible + " of " + items.length + " guides";
      }
      if (empty instanceof HTMLElement) {
        empty.hidden = visible !== 0;
        if (queryEl) queryEl.textContent = input.value.trim();
      }
    };

    document.addEventListener("input", (e) => {
      const input = (e.target as HTMLElement)?.closest?.(
        "[data-catalog-filter]"
      );
      if (!(input instanceof HTMLInputElement)) return;
      const root = input.closest("[data-catalog]");
      if (root) applyFilter(root);
    });

    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement)?.closest?.(
        "[data-catalog-reset]"
      );
      if (!(btn instanceof HTMLElement)) return;
      const root = btn.closest("[data-catalog]");
      if (!root) return;
      const input =
        root.querySelector<HTMLInputElement>("[data-catalog-filter]");
      if (input) {
        input.value = "";
        applyFilter(root);
        input.focus();
      }
    });

    document.addEventListener("astro:page-load", () => {
      document.querySelectorAll("[data-catalog]").forEach(applyFilter);
    });
  }
</script>

<style>
  .catalog {
    max-width: 58rem;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Header row: live totals + discovery field. */
  .catalog-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 1.25rem;
  }

  .catalog-count {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--sl-color-white) 55%, transparent);
  }

  .catalog-filter {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .catalog-filter-icon {
    position: absolute;
    left: 0.7rem;
    display: grid;
    place-items: center;
    pointer-events: none;
    color: color-mix(in srgb, var(--sl-color-white) 45%, transparent);
  }

  .catalog-filter-input {
    width: min(15rem, 100%);
    padding: 0.5rem 0.9rem 0.5rem 2.2rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: 0.875rem;
    line-height: 1.4;
    transition: border-color 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .catalog-filter-input::placeholder {
    color: color-mix(in srgb, var(--sl-color-white) 42%, transparent);
  }

  .catalog-filter-input:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--sl-color-accent) 60%, transparent);
    outline-offset: 2px;
    border-color: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
  }

  /* Responsive grid: 1 column on mobile, 2 columns at wide viewports. */
  .course-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.875rem;
  }

  @media (min-width: 60rem) {
    .course-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .course-list > li {
    display: flex;
    min-width: 0;
  }

  .course-list > li[hidden] {
    display: none;
  }

  .course-card {
    flex: 1 1 auto;
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    min-width: 0;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 14px;
    background: var(--sl-color-black);
    text-decoration: none;
    transition:
      border-color 180ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 180ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 180ms cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  /* The catalog renders inside .sl-markdown-content, whose prose rule
     underlines anchors (higher specificity than a bare class) — opt out
     with a qualified selector, on the anchor itself: descendant overrides
     can't remove a propagated underline. */
  .catalog .course-card {
    text-decoration: none;
  }

  .course-card:hover,
  .course-card:focus-visible {
    border-color: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    background: color-mix(in srgb, var(--sl-color-accent) 5%, var(--sl-color-black));
  }

  .course-card:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--sl-color-accent) 60%, transparent);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .course-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
    }
    .course-card:hover .course-arrow {
      transform: translateX(3px);
    }
  }

  .course-card:active {
    transform: scale(0.98);
  }

  /* Neutral icon wash — accent stays out of the chips. */
  .course-chip {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--sl-color-white) 5%, transparent);
    color: color-mix(in srgb, var(--sl-color-white) 72%, transparent);
  }

  .course-body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .course-title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--sl-color-white);
  }

  .course-desc {
    margin-top: 0.35rem;
    margin-bottom: 0.8rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--sl-color-white) 68%, transparent);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Meta row: page count + Start affordance, feet aligned across rows. */
  .course-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.65rem;
  }

  .course-meta {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--sl-color-white) 55%, transparent);
  }

  .course-start {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    color: color-mix(in srgb, var(--sl-color-white) 72%, transparent);
  }

  .course-arrow {
    transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .course-card:hover .course-start,
  .course-card:focus-visible .course-start {
    color: var(--sl-color-white);
  }

  .course-card:focus-visible .course-arrow {
    transform: translateX(3px);
  }

  /* Empty state for the filter. */
  .catalog-empty {
    margin-top: 0.875rem;
    padding: 2.5rem 1rem;
    border: 1px dashed var(--sl-color-hairline);
    border-radius: 14px;
    text-align: center;
  }

  .catalog-empty p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--sl-color-white) 68%, transparent);
  }

  .catalog-reset {
    margin-top: 1rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-white) 5%, transparent);
    color: var(--sl-color-white);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 180ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .catalog-reset:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--sl-color-accent) 60%, transparent);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .catalog-reset:hover {
      border-color: color-mix(in srgb, var(--sl-color-white) 28%, transparent);
    }
  }

  .catalog-reset:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .course-card,
    .course-arrow,
    .catalog-filter-input,
    .catalog-reset {
      transition: none;
    }
    .course-card:hover,
    .course-card:focus-visible,
    .course-card:active,
    .catalog-reset:active {
      transform: none;
    }
  }
</style>
