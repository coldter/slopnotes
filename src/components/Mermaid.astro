---
/**
 * Mermaid.astro — interactive, theme-aware Mermaid diagram.
 *
 * Renders the diagram client-side with mermaid.js and wraps the SVG in a
 * pan / zoom / fullscreen viewport.
 *
 * Usage (in an .mdx file):
 *   import Mermaid from "~/components/Mermaid.astro";
 *   <Mermaid title="Request flow" code={`
 *     flowchart LR
 *       A --> B
 *   `} />
 *
 * Controls: scroll to zoom (toward the cursor), drag to pan, double-click to
 * zoom in, pinch on touch, and the toolbar buttons for zoom / fit / fullscreen.
 */
interface Props {
  /** The Mermaid diagram definition. */
  code: string;
  /** Optional label shown in the toolbar. */
  title?: string;
  /** Viewport height in px (non-fullscreen). Default 440. */
  height?: number;
}
const { code, title = "Diagram", height = 480 } = Astro.props;
---

<figure class="mermaid-block" style={`--mmd-height:${height}px`}>
  <figcaption class="mermaid-bar">
    <span class="mermaid-title">{title}</span>
    <div class="mermaid-actions">
      <button type="button" data-mmd="zoom-out" aria-label="Zoom out" title="Zoom out">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M5 12h14" /></svg>
      </button>
      <button type="button" data-mmd="zoom-in" aria-label="Zoom in" title="Zoom in">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
      </button>
      <span class="mermaid-sep" aria-hidden="true"></span>
      <button type="button" data-mmd="reset" aria-label="Reset view" title="Reset view">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36L21 8" /><path d="M21 3v5h-5" /></svg>
      </button>
      <button type="button" data-mmd="fullscreen" aria-label="Toggle fullscreen" title="Fullscreen">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3" /></svg>
      </button>
    </div>
  </figcaption>
  <div class="mermaid-viewport" tabindex="0">
    <div class="mermaid-canvas"></div>
    <div class="mermaid-loading">Rendering diagram…</div>
  </div>
  <pre class="mermaid-src" hidden set:text={code} />
</figure>

<style>
    .mermaid-block {
      margin: 1.75rem 0;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 12px;
      overflow: hidden;
      background: var(--sl-color-black);
    }
    .mermaid-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.45rem 0.5rem 0.45rem 0.85rem;
      border-bottom: 1px solid var(--sl-color-hairline);
      background: color-mix(in srgb, var(--sl-color-white) 3%, transparent);
    }
    .mermaid-title {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: color-mix(in srgb, var(--sl-color-white) 78%, transparent);
    }
    .mermaid-actions {
      display: flex;
      align-items: center;
      gap: 1px;
      padding: 3px;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 9px;
      background: color-mix(in srgb, var(--sl-color-white) 4%, transparent);
    }
    .mermaid-sep {
      flex: none;
      width: 1px;
      height: 16px;
      margin: 0 3px;
      background: var(--sl-color-hairline);
    }
    .mermaid-actions button {
      display: grid;
      place-items: center;
      width: 28px;
      height: 28px;
      padding: 0;
      margin: 0;
      border: 0;
      border-radius: 6px;
      background: transparent;
      color: color-mix(in srgb, var(--sl-color-white) 74%, transparent);
      line-height: 0;
      cursor: pointer;
      transition:
        color 0.15s ease,
        background-color 0.15s ease;
    }
    .mermaid-actions button:hover {
      color: var(--sl-color-accent);
      background: color-mix(in srgb, var(--sl-color-white) 9%, transparent);
    }
    .mermaid-actions button:active {
      background: color-mix(in srgb, var(--sl-color-white) 14%, transparent);
    }
    .mermaid-actions svg {
      display: block;
      width: 16px;
      height: 16px;
    }
    .mermaid-viewport {
      position: relative;
      height: var(--mmd-height, 440px);
      overflow: hidden;
      cursor: grab;
      touch-action: none;
      background-image: radial-gradient(
        circle at 1px 1px,
        color-mix(in srgb, var(--sl-color-white) 8%, transparent) 1px,
        transparent 0
      );
      background-size: 22px 22px;
    }
    .mermaid-viewport.is-grabbing {
      cursor: grabbing;
    }
    .mermaid-canvas {
      position: absolute;
      top: 0;
      left: 0;
      transform-origin: 0 0;
      will-change: transform;
    }
    .mermaid-canvas :global(svg) {
      display: block;
    }
    .mermaid-loading {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8125rem;
      color: color-mix(in srgb, var(--sl-color-white) 68%, transparent);
    }
    .mermaid-block.is-ready .mermaid-loading {
      display: none;
    }
    .mermaid-error {
      margin: 0;
      padding: 1rem;
      white-space: pre-wrap;
      font-size: 0.8125rem;
      color: #ef4444;
    }

    .mermaid-block:fullscreen,
    .mermaid-block:-webkit-full-screen {
      width: 100vw;
      height: 100vh;
      margin: 0;
      border: 0;
      border-radius: 0;
      display: flex;
      flex-direction: column;
      background: var(--sl-color-black);
    }
    .mermaid-block:fullscreen .mermaid-viewport,
    .mermaid-block:-webkit-full-screen .mermaid-viewport {
      height: auto;
      flex: 1;
    }
</style>

<script>
  import mermaid from "mermaid";

  const MIN = 0.15;
  const MAX = 10;
  let svgCounter = 0;

  const isLight = () => document.documentElement.dataset.theme === "light";

  function themeVariables() {
    const light = isLight();
    const accent = light ? "#16A34A" : "#22C55E";
    const text = light ? "#14532d" : "#e7f5ec";
    const nodeBg = light ? "#e6f7ed" : "#102a1c";
    const surface = light ? "#f3f5f4" : "#191919";
    const line = light ? "#64748b" : "#7e8f85";
    return {
      darkMode: !light,
      fontFamily: "var(--font-primary, ui-sans-serif, system-ui, sans-serif)",
      fontSize: "16px",
      background: "transparent",
      primaryColor: nodeBg,
      primaryBorderColor: accent,
      primaryTextColor: text,
      secondaryColor: surface,
      secondaryBorderColor: line,
      secondaryTextColor: text,
      tertiaryColor: light ? "#fafafa" : "#161616",
      tertiaryBorderColor: light ? "#e5e7eb" : "#2a2a2a",
      tertiaryTextColor: text,
      lineColor: line,
      textColor: text,
      mainBkg: nodeBg,
      nodeBorder: accent,
      clusterBkg: light ? "#f6f8f7" : "#141414",
      clusterBorder: light ? "#cfdad3" : "#37433c",
      titleColor: text,
      edgeLabelBackground: light ? "#ffffff" : "#0d0d0d",
      actorBkg: nodeBg,
      actorBorder: accent,
      actorTextColor: text,
      actorLineColor: line,
      signalColor: text,
      signalTextColor: text,
      // autonumber bubble: the circle is filled with signalColor (= text), so the
      // number must be the opposite shade or it disappears (white-on-white / green-on-green).
      sequenceNumberColor: light ? "#ffffff" : "#0d1f14",
      labelBoxBkgColor: nodeBg,
      labelBoxBorderColor: accent,
      labelTextColor: text,
      loopTextColor: text,
      noteBkgColor: light ? "#fff7ed" : "#23201a",
      noteTextColor: text,
      noteBorderColor: light ? "#f0d9b5" : "#3a3320",
      // git graph — dark branch labels read clearly on the bright branch colors;
      // commit/tag labels get explicit colors so they aren't low-contrast.
      git0: accent,
      git1: light ? "#0ea5e9" : "#38bdf8",
      git2: light ? "#a855f7" : "#c084fc",
      git3: light ? "#f59e0b" : "#fbbf24",
      gitBranchLabel0: "#0b110d",
      gitBranchLabel1: "#0b110d",
      gitBranchLabel2: "#0b110d",
      gitBranchLabel3: "#0b110d",
      commitLabelColor: text,
      commitLabelBackground: light ? "#ffffff" : "#1b211d",
      tagLabelColor: text,
      tagLabelBackground: light ? "#f3f5f4" : "#1b211d",
      tagLabelBorder: accent,
    };
  }

  function setupView(fig: HTMLElement) {
    const viewport = fig.querySelector(".mermaid-viewport") as HTMLElement;
    const canvas = fig.querySelector(".mermaid-canvas") as HTMLElement;
    let scale = 1;
    let x = 0;
    let y = 0;
    let natW = 0;
    let natH = 0;

    const apply = () => {
      canvas.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
    };

    const fit = () => {
      const vw = viewport.clientWidth;
      const vh = viewport.clientHeight;
      if (!natW || !natH || !vw || !vh) return;
      const fitW = (vw * 0.95) / natW;
      const fitH = (vh * 0.95) / natH;
      const contain = Math.min(fitW, fitH);
      if (contain >= 0.8) {
        // whole diagram fits comfortably — center it
        scale = Math.min(contain, 1.5);
        x = (vw - natW * scale) / 2;
        y = (vh - natH * scale) / 2;
      } else {
        // large/tall diagram — start at a readable scale, fill the width,
        // align to the top so the diagram begins in view (pan/scroll for more)
        scale = Math.max(MIN, Math.min(fitW, 1.1));
        x = (vw - natW * scale) / 2;
        y = 20;
      }
      apply();
    };

    const zoomAt = (px: number, py: number, factor: number) => {
      const ns = Math.min(MAX, Math.max(MIN, scale * factor));
      const k = ns / scale;
      x = px - (px - x) * k;
      y = py - (py - y) * k;
      scale = ns;
      apply();
    };

    viewport.addEventListener(
      "wheel",
      (e) => {
        e.preventDefault();
        const r = viewport.getBoundingClientRect();
        zoomAt(e.clientX - r.left, e.clientY - r.top, e.deltaY < 0 ? 1.12 : 1 / 1.12);
      },
      { passive: false },
    );

    const pointers = new Map<number, { x: number; y: number }>();
    let lastDist = 0;
    viewport.addEventListener("pointerdown", (e) => {
      viewport.setPointerCapture(e.pointerId);
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      viewport.classList.add("is-grabbing");
    });
    viewport.addEventListener("pointermove", (e) => {
      if (!pointers.has(e.pointerId)) return;
      const prev = pointers.get(e.pointerId)!;
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 1) {
        x += e.clientX - prev.x;
        y += e.clientY - prev.y;
        apply();
      } else if (pointers.size === 2) {
        const pts = [...pointers.values()];
        const dist = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
        const r = viewport.getBoundingClientRect();
        const mx = (pts[0].x + pts[1].x) / 2 - r.left;
        const my = (pts[0].y + pts[1].y) / 2 - r.top;
        if (lastDist) zoomAt(mx, my, dist / lastDist);
        lastDist = dist;
      }
    });
    const end = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      if (pointers.size < 2) lastDist = 0;
      if (pointers.size === 0) viewport.classList.remove("is-grabbing");
    };
    viewport.addEventListener("pointerup", end);
    viewport.addEventListener("pointercancel", end);
    viewport.addEventListener("pointerleave", end);
    viewport.addEventListener("dblclick", (e) => {
      const r = viewport.getBoundingClientRect();
      zoomAt(e.clientX - r.left, e.clientY - r.top, 1.6);
    });

    return {
      fit,
      setNatural(w: number, h: number) {
        natW = w;
        natH = h;
        fit();
      },
      zoomCenter(factor: number) {
        zoomAt(viewport.clientWidth / 2, viewport.clientHeight / 2, factor);
      },
    };
  }

  async function initFig(fig: HTMLElement) {
    if (fig.dataset.mmdInit === "1") return;
    fig.dataset.mmdInit = "1";
    const src = (fig.querySelector(".mermaid-src") as HTMLElement).textContent || "";
    const canvas = fig.querySelector(".mermaid-canvas") as HTMLElement;
    const view = setupView(fig);

    const draw = async () => {
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: "loose",
        theme: "base",
        themeVariables: themeVariables(),
        themeCSS: `
          .node rect, .node polygon, .node path, .node circle, .node ellipse { stroke-width: 1.5px; }
          .node rect { rx: 8px; ry: 8px; }
          .nodeLabel, .edgeLabel, .cluster-label .nodeLabel { font-weight: 500; }
          .edgePaths .path, .flowchart-link { stroke-width: 1.5px; }
          .cluster rect { rx: 12px; ry: 12px; stroke-width: 1.25px; }
          .messageLine0, .messageLine1 { stroke-width: 1.5px; }
          marker path { stroke-width: 1px; }
        `,
        flowchart: {
          curve: "basis",
          htmlLabels: true,
          padding: 16,
          nodeSpacing: 55,
          rankSpacing: 62,
        },
        sequence: { useMaxWidth: false, mirrorActors: false },
      });
      try {
        const { svg, bindFunctions } = await mermaid.render(
          "mmd-svg-" + svgCounter++,
          src.trim(),
        );
        canvas.innerHTML = svg;
        const el = canvas.querySelector("svg") as SVGSVGElement;
        const vb = el.viewBox && el.viewBox.baseVal;
        const rect = el.getBoundingClientRect();
        const w = vb && vb.width ? vb.width : rect.width;
        const h = vb && vb.height ? vb.height : rect.height;
        el.removeAttribute("width");
        el.removeAttribute("height");
        el.setAttribute("width", String(w));
        el.setAttribute("height", String(h));
        el.style.maxWidth = "none";
        canvas.style.width = w + "px";
        canvas.style.height = h + "px";
        bindFunctions?.(canvas);
        view.setNatural(w, h);
        fig.classList.add("is-ready");
      } catch (err: any) {
        canvas.innerHTML =
          '<pre class="mermaid-error">' +
          String(err && err.message ? err.message : err) +
          "</pre>";
        fig.classList.add("is-ready");
      }
    };

    await draw();
    (fig as any)._redraw = draw;

    fig
      .querySelector('[data-mmd="zoom-in"]')
      ?.addEventListener("click", () => view.zoomCenter(1.25));
    fig
      .querySelector('[data-mmd="zoom-out"]')
      ?.addEventListener("click", () => view.zoomCenter(1 / 1.25));
    fig.querySelector('[data-mmd="reset"]')?.addEventListener("click", () => view.fit());
    fig.querySelector('[data-mmd="fullscreen"]')?.addEventListener("click", () => {
      if (document.fullscreenElement === fig) document.exitFullscreen();
      else fig.requestFullscreen?.();
    });
    fig.addEventListener("fullscreenchange", () => setTimeout(() => view.fit(), 80));
  }

  function renderAll() {
    document
      .querySelectorAll<HTMLElement>("figure.mermaid-block")
      .forEach((fig) => initFig(fig));
  }

  // Re-render (colors are baked into the SVG) when the site theme flips.
  let themeTimer: ReturnType<typeof setTimeout>;
  new MutationObserver(() => {
    clearTimeout(themeTimer);
    themeTimer = setTimeout(() => {
      document
        .querySelectorAll<HTMLElement>("figure.mermaid-block")
        .forEach((fig) => (fig as any)._redraw && (fig as any)._redraw());
    }, 90);
  }).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });

  document.addEventListener("astro:page-load", renderAll);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", renderAll);
  } else {
    renderAll();
  }
</script>
